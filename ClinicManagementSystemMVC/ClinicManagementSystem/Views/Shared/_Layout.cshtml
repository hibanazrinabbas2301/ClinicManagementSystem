<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Clinic Management System</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

    <div class="app-container">

        <!-- ================= SIDEBAR ================= -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <h4>Wellness Clinic</h4>
            </div>

            <ul class="sidebar-menu">

                <li>
                    <a asp-controller="Home" asp-action="Dashboard">
                        <i class="bi bi-speedometer2"></i> Dashboard
                    </a>
                </li>

                <li>
                    <a asp-controller="Home" asp-action="Privacy">
                        <i class="bi bi-shield-lock"></i> Privacy
                    </a>
                </li>

                <!-- Add Role-Based Links Later -->
            </ul>
        </aside>

        <!-- ================= MAIN SECTION ================= -->
        <div class="main-section">

            <!-- ================= TOP NAVBAR ================= -->
            <header class="top-navbar">
                <div class="navbar-left">
                    <h5 class="page-title">@ViewData["Title"]</h5>
                </div>

                <div class="navbar-right">

                    @if (Context.Session.GetString("UserName") != null)
                    {
                        <span class="user-name">
                            👋 @Context.Session.GetString("UserName")
                        </span>

                        <a class="btn btn-sm btn-danger"
                           asp-controller="Login"
                           asp-action="Logout">
                            <i class="bi bi-box-arrow-right"></i> Logout
                        </a>
                    }

                </div>
            </header>

            <!-- ================= CONTENT ================= -->
            <main class="content-area">
                @RenderBody()
            </main>

        </div>

    </div>

    <!-- ================= SCRIPTS ================= -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <!-- ================= TOAST SYSTEM ================= -->
    <div class="toast-container position-fixed top-0 end-0 p-3">
        <div id="successToast" class="toast align-items-center text-white bg-success border-0" role="alert">
            <div class="d-flex">
                <div class="toast-body" id="toastMessage"></div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto"
                        data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>

</body>
</html>