@model ClinicManagementSystem.View_Model.UserModel

@{
    ViewData["Title"] = "Clinic Login";
    Layout = null;   // Important: Keep login separate from dashboard layout
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Clinic Login</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="login-body">

    <div class="login-wrapper">

        <div class="login-card">

            <!-- Logo & Title -->
            <div class="text-center mb-4">
                <div class="login-icon">
                    <i class="bi bi-hospital"></i>
                </div>

                <h2 class="login-title mt-3">
                    Wellness CLinic
                </h2>

                <p class="login-subtitle">
                    Secure Staff Login Portal
                </p>
            </div>

            <!-- Login Form -->
            <form asp-action="Index" method="post">

                <!-- Validation Summary -->
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <!-- Username -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        Username
                    </label>

                    <div class="input-group">
                        <span class="input-group-text bg-light">
                            <i class="bi bi-person"></i>
                        </span>

                        <input asp-for="UserName"
                               class="form-control"
                               placeholder="Enter your username" />
                    </div>

                    <span asp-validation-for="UserName" class="text-danger"></span>
                </div>

                <!-- Password -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        Password
                    </label>

                    <div class="input-group">
                        <span class="input-group-text bg-light">
                            <i class="bi bi-lock"></i>
                        </span>

                        <input asp-for="UserPassword"
                               type="password"
                               class="form-control"
                               placeholder="Enter your password" />
                    </div>

                    <span asp-validation-for="UserPassword" class="text-danger"></span>
                </div>

                <!-- Wrong Credentials Error -->
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger text-center mt-3">
                        @ViewBag.Error
                    </div>
                }

                <!-- Login Button -->
                <div class="d-grid mt-4">
                    <button type="submit" class="btn btn-primary btn-login">
                        <i class="bi bi-box-arrow-in-right me-2"></i>
                        Login
                    </button>
                </div>

            </form>

            <!-- Footer -->
            <div class="login-footer">
                © @DateTime.Now.Year Clinic Management System <br />
                All Rights Reserved
            </div>

        </div>

    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }

</body>
</html>