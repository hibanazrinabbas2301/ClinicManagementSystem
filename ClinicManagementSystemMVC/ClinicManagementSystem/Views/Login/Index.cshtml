@model ClinicManagementSystem.View_Model.UserModel

@{
    ViewData["Title"] = "Clinic Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Medical Trust</title>

    <!-- ✅ Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- ✅ Font Awesome Icons -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <style>
        body {
            background: linear-gradient(to right, #e3f2fd, #ffffff);
            font-family: 'Segoe UI', sans-serif;
        }

        .login-container {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .login-card {
            width: 100%;
            max-width: 420px;
            padding: 35px;
            border-radius: 18px;
            background: white;
            box-shadow: 0px 8px 25px rgba(0,0,0,0.15);
        }

        .clinic-logo {
            font-size: 55px;
            color: #0d6efd;
        }

        .login-title {
            font-weight: 700;
            font-size: 26px;
        }

        .sub-title {
            font-size: 14px;
            color: gray;
        }

        .form-control {
            height: 45px;
            border-radius: 10px;
        }

        .btn-login {
            height: 45px;
            border-radius: 10px;
            font-weight: 600;
        }

        .footer-text {
            font-size: 13px;
            color: gray;
            text-align: center;
            margin-top: 20px;
        }
    </style>
</head>

<body>

    <div class="login-container">

        <div class="login-card">

            <!-- ✅ Clinic Logo -->
            <div class="text-center mb-4">
                <i class="fa-solid fa-hospital clinic-logo"></i>

                <h2 class="login-title mt-2">
                    Medical Trust Hospital
                </h2>

                <p class="sub-title">
                    Secure Login Portal for Staff
                </p>
            </div>

            <!-- ✅ Login Form -->
            <form asp-action="Index" method="post">

                <!-- Validation Summary -->
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <!-- Username -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        Username
                    </label>

                    <div class="input-group">
                        <span class="input-group-text bg-light">
                            <i class="fa fa-user"></i>
                        </span>

                        <input asp-for="UserName"
                               class="form-control"
                               placeholder="Enter your username" />
                    </div>

                    <span asp-validation-for="UserName" class="text-danger"></span>
                </div>

                <!-- Password -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        Password
                    </label>

                    <div class="input-group">
                        <span class="input-group-text bg-light">
                            <i class="fa fa-lock"></i>
                        </span>

                        <input asp-for="UserPassword"
                               type="password"
                               class="form-control"
                               placeholder="Enter your password" />
                    </div>

                    <span asp-validation-for="UserPassword" class="text-danger"></span>
                </div>

                <!-- Wrong Credentials Error -->
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger text-center mt-3">
                        @ViewBag.Error
                    </div>
                }

                <!-- Login Button -->
                <div class="d-grid mt-4">
                    <button type="submit" class="btn btn-primary btn-login">
                        <i class="fa-solid fa-right-to-bracket"></i>
                        Login
                    </button>
                </div>

            </form>

            <!-- Footer -->
            <div class="footer-text">
                © @DateTime.Now.Year Clinic Management System <br />
                All Rights Reserved
            </div>

        </div>

    </div>

    <!-- ✅ Client-side Validation Scripts -->
    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }

</body>
</html>
