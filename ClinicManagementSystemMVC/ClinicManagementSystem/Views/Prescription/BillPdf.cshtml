@model List<ClinicManagementSystem.ViewModel.IssuedMedicineBillViewModel>
@{
    Layout = null;
    var patient = Model.First().PatientName;
    var appointId = Model.First().AppointmentId;
    var issueDate = Model.First().IssueDate.ToString("dd-MM-yyyy");
    var grandTotal = Model.Sum(x => x.TotalAmount);
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Medicine Bill</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            padding: 30px;
        }

        h2 {
            text-align: center;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        th, td {
            border: 1px solid #333;
            padding: 8px 12px;
            text-align: left;
        }

        thead {
            background-color: #333;
            color: white;
        }

        tfoot {
            background-color: #eee;
            font-weight: bold;
        }

        .info {
            margin-bottom: 10px;
        }

        @@media print {
            .no-print {
                display: none;
            }
        }
    </style>
</head>
<body onload="window.print()">

    <h2>Clinic Management System</h2>
    <h4 style="text-align:center;">Medicine Bill</h4>
    <hr />

    <div class="info">
        <strong>Patient Name:</strong> @patient &nbsp;&nbsp;
        <strong>Appointment ID:</strong> @appointId &nbsp;&nbsp;
        <strong>Date:</strong> @issueDate
    </div>

    <table>
        <thead>
            <tr>
                <th>Medicine</th>
                <th>Quantity</th>
                <th>Price (₹)</th>
                <th>Total (₹)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.MedicineName</td>
                    <td>@item.QuantityIssued</td>
                    <td>₹@item.Price.ToString("F2")</td>
                    <td>₹@item.TotalAmount.ToString("F2")</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="3">Grand Total</td>
                <td>₹@grandTotal.ToString("F2")</td>
            </tr>
        </tfoot>
    </table>

    <br />
    <p style="text-align:center;" class="no-print">
        <button onclick="window.print()"
                style="padding:8px 20px; background:#333; color:white; border:none; cursor:pointer;">
            🖨️ Print / Save as PDF
        </button>
    </p>

</body>
</html>