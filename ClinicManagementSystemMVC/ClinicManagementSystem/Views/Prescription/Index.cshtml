@model IEnumerable<ClinicManagementSystem.ViewModel.PendingAppointmentViewModel>

@{
    ViewData["Title"] = "Pending Prescriptions";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Pending Prescriptions</h2>
        <a href="/Prescription/IssuedBills" class="btn btn-success">
            <i class="bi bi-receipt"></i> View Bills
        </a>
    </div>

    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>Appointment Id</th>
                <th>Patient</th>
                <th>Date</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.AppointmentId</td>
                        <td>@item.PatientName</td>
                        <td>@item.PrescribedDate.ToString("dd-MM-yyyy")</td>
                        <td>
                            <button class="btn btn-primary btn-sm viewBtn"
                                    data-id="@item.AppointmentId">
                                <i class="bi bi-eye"></i> View
                            </button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">
                        No Pending Prescriptions
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>

<!-- Prescription Modal -->
<div class="modal fade" id="prescriptionModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Prescription Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Medicine</th>
                            <th>Quantity</th>
                            <th>Frequency</th>
                            <th>Duration</th>
                            <th>Issue</th>
                        </tr>
                    </thead>
                    <tbody id="prescriptionDetailsBody">
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {

            // ==============================
            // VIEW PRESCRIPTION DETAILS
            // ==============================
            $(document).on("click", ".viewBtn", function () {

                var appointmentId = $(this).data("id");

                $.get("/Prescription/GetPrescriptionDetails",
                    { appointmentId: appointmentId },
                    function (data) {

                        $("#prescriptionDetailsBody").empty();

                        $.each(data, function (i, item) {

                            $("#prescriptionDetailsBody").append(
                                `<tr>
                                    <td>${item.medicineName}</td>
                                    <td>${item.quantity}</td>
                                    <td>${item.frequency}</td>
                                    <td>${item.durationDays}</td>

                                    <td>
                                        <button class="btn btn-success issueSingleBtn"
                                                data-id="${item.prescriptionId}">
                                            Issue
                                        </button>
                                    </td>
                                </tr>`
                            );
                        });

                        $("#prescriptionModal").modal("show");
                    });
            });


            // ==============================
            // ISSUE SINGLE MEDICINE (Correct)
            // ==============================
            $(document).on("click", ".issueSingleBtn", function () {

                var prescriptionId = $(this).data("id");

                $.ajax({
                    url: "/Prescription/Issue",
                    type: "POST",
                    data: { prescriptionId: prescriptionId },

                    success: function (response) {

                        if (response.success) {
                            alert("✅ Medicine Issued Successfully!");
                            location.reload();
                        }
                        else {
                            alert(response.message);
                        }
                    },

                    error: function () {
                        alert("Error occurred while issuing medicine.");
                    }
                });
            });

        });
    </script>
}
