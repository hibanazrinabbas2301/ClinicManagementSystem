@model IEnumerable<ClinicManagementSystem.ViewModel.MedicineViewModel>

@{
    ViewData["Title"] = "Pharmacy Inventory";
}

<div class="container mt-4">

    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Pharmacy Inventory</h2>

        <button type="button"
                class="btn btn-success"
                id="openAddModal">
            <i class="bi bi-plus-circle"></i> Add Medicine
        </button>


    </div>

    <!-- Inventory Table -->
    <div class="card shadow-sm">
        <div class="card-body">

            <table class="table table-bordered table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Medicine Name</th>
                        <th>Description</th>
                        <th>Category</th>
                        <th>Stock</th>
                        <th>Expiry Date</th>
                        <th>Price</th>
                        <th width="150">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.MedicineName</td>
                                <td>@item.MedicineDescription</td>
                                <td>@item.CategoryName</td>
                                <td>@item.CurrentStock</td>
                                <td>@item.ExpiryDate.ToString("dd-MM-yyyy")</td>
                                <td>@item.Price.ToString("0.00")</td>

                                <td>
                                    <a asp-controller="Pharmacist"
                                       asp-action="EditMedicine"
                                       asp-route-id="@item.MedicineId"
                                       class="btn btn-sm btn-primary me-2">
                                        Edit
                                    </a>

                                    <a asp-controller="Pharmacist"
                                       asp-action="DeleteMedicine"
                                       asp-route-id="@item.MedicineId"
                                       class="btn btn-sm btn-danger"
                                       onclick="return confirm('Are you sure you want to delete this medicine?');">
                                        Delete
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center">
                                No medicines available.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>



    <!-- Add Medicine Modal -->
    <div class="modal fade" id="addMedicineModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Add Medicine</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">

                    <form id="addMedicineForm">

                        <div class="mb-3">
                            <label>Medicine Name</label>
                            <input type="text"
                                   class="form-control"
                                   name="MedicineName"
                                   required />
                        </div>

                        <div class="mb-3">
                            <label>Description</label>
                            <textarea class="form-control"
                                      name="Description"></textarea>
                        </div>

                        <div class="mb-3">
                            <label>Category</label>
                            <select class="form-control"
                                    name="CategoryId"
                                    id="CategoryId"
                                    required>
                                <option value="">-- Select Category --</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label>Stock</label>
                            <input type="number"
                                   class="form-control"
                                   name="Quantity"
                                   required />
                        </div>

                        <div class="mb-3">
                            <label>Expiry Date</label>
                            <input type="date"
                                   class="form-control"
                                   name="ExpiryDate"
                                   required />
                        </div>

                        <div class="mb-3">
                            <label>Price</label>
                            <input type="number"
                                   step="0.01"
                                   class="form-control"
                                   name="Price"
                                   required />
                        </div>

                    </form>

                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="button"
                            class="btn btn-primary"
                            id="saveMedicine">
                        Save
                    </button>
                </div>

            </div>
        </div>
    </div>

</div>
@section Scripts {
    <script>
        $(document).ready(function () {

            // Open modal
                  $("#openAddModal").click(function () {
            $("#addMedicineModal").modal("show");
          });

            // Save medicine
            $("#saveMedicine").click(function () {

                var formData = $("#addMedicineForm").serialize();

                $.ajax({
                    url: "/Pharmacist/Index",
                    type: "POST",
                    data: formData,
                    success: function (response) {

                        if (response.success) {

                            var newRow =
                                `<tr>
                                    <td>${response.name}</td>
                                    <td>${response.description}</td>
                                    <td></td>
                                    <td>${response.stock}</td>
                                    <td>${response.expiry}</td>
                                    <td>${response.price}</td>
                                    <td>
                                        <button class="btn btn-sm btn-primary">Edit</button>
                                        <button class="btn btn-sm btn-danger">Delete</button>
                                    </td>
                                </tr>`;

                            $("table tbody").append(newRow);

                            $("#addMedicineModal").modal("hide");
                            $("#addMedicineForm")[0].reset();
                        }
                        else {
                            alert("Validation failed");
                        }
                    },
                    error: function () {
                        alert("Error occurred");
                    }
                });

            });

        });
    </script>
}
