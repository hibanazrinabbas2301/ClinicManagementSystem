@model IEnumerable<ClinicManagementSystem.ViewModel.MedicineViewModel>

@{
    ViewData["Title"] = "Pharmacy Inventory";
}

<div class="container mt-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Pharmacy Inventory</h2>
        <button class="btn btn-success" id="openAddModal">
            <i class="bi bi-plus-circle"></i> Add Medicine
        </button>
    </div>

    <!-- Table -->
    <div class="card shadow-sm">
        <div class="card-body">

            @if (Model != null && Model.Any())
            {
                <table class="table table-bordered table-striped align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Category</th>
                            <th>Stock</th>
                            <th>Expiry</th>
                            <th>Price</th>
                            <th width="120">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.MedicineName</td>
                                <td>@(item.MedicineDescription ?? "-")</td>
                                <td>@(item.CategoryName ?? "-")</td>
                                <td>@item.CurrentStock</td>
                                <td>@item.ExpiryDate?.ToString("dd-MM-yyyy")</td>
                                <td>₹ @item.Price.ToString("0.00")</td>
                                <td>
                                    <button class="btn btn-sm btn-primary editBtn"
                                            data-id="@item.MedicineId"
                                            data-name="@item.MedicineName"
                                            data-description="@item.MedicineDescription"
                                            data-categoryid="@item.CategoryId"
                                            data-stock="@item.CurrentStock"
                                            data-price="@item.Price"
                                            data-expiry="@(item.ExpiryDate.HasValue
                                                                                            ? item.ExpiryDate.Value.ToString("yyyy-MM-dd")
                                                                                    : "")">
                                Edit
                            </button>
                        </td>
                    </tr>
                                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="text-center text-muted py-4">
                    No medicines available.
                </div>
            }

        </div>
    </div>
</div>

<!-- ================= ADD MODAL ================= -->

<div class="modal fade" id="addMedicineModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5>Add Medicine</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <form id="addMedicineForm">

                    <div class="mb-3">
                        <label>Name</label>
                        <input class="form-control" name="MedicineName" required />
                    </div>

                    <div class="mb-3">
                        <label>Description</label>
                        <textarea class="form-control" name="Description"></textarea>
                    </div>

                    <div class="mb-3">
                        <label>Category</label>
                        <select class="form-control" name="CategoryId" id="CategoryId" required>
                            <option value="">-- Select Category --</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label>Stock</label>
                        <input type="number" class="form-control" name="Quantity" min="0" required />
                        <span class="text-danger" id="quantityError"></span>
                    </div>

                    <div class="mb-3">
                        <label>Expiry</label>
                        <input type="date" class="form-control" name="ExpiryDate" required />
                        <span class="text-danger" id="expiryError"></span>
                    </div>

                    <div class="mb-3">
                        <label>Price</label>
                        <input type="number" step="0.01" class="form-control" name="Price" min="0.01" required />
                        <span class="text-danger" id="priceError"></span>
                    </div>

                </form>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-primary" id="saveMedicine">Save</button>
            </div>

        </div>
    </div>
</div>

<!-- ================= EDIT MODAL ================= -->

<div class="modal fade" id="editMedicineModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5>Edit Medicine</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <form id="editMedicineForm">

                    <input type="hidden" name="MedicineId" id="EditMedicineId" />

                    <div class="mb-3">
                        <label>Name</label>
                        <input class="form-control" name="MedicineName" id="EditMedicineName" />
                    </div>

                    <div class="mb-3">
                        <label>Description</label>
                        <textarea class="form-control"
                                  name="MedicineDescription"
                                  id="EditDescription"></textarea>
                    </div>

                    <div class="mb-3">
                        <label>Category</label>
                        <select class="form-control" name="CategoryId" id="EditCategoryId"></select>
                    </div>

                    <div class="mb-3">
                        <label>Current Stock</label>
                        <input class="form-control" id="EditCurrentStock" readonly />
                    </div>

                    <div class="mb-3">
                        <label>Add Stock</label>
                        <input type="number" class="form-control"
                               name="AddedQuantity" />
                        <span class="text-danger" id="editStockError"></span>
                    </div>

                    <div class="mb-3">
                        <label>Current Price</label>
                        <input class="form-control" id="EditCurrentPrice" readonly />
                    </div>

                    <div class="mb-3">
                        <label>New Price</label>
                        <input type="number" step="0.01"
                               class="form-control"
                               name="NewPrice" />
                        <span class="text-danger" id="editPriceError"></span>
                    </div>

                    <div class="mb-3">
                        <label>Current Expiry</label>
                        <input class="form-control" id="EditCurrentExpiry" readonly />
                    </div>

                    <div class="mb-3">
                        <label>New Expiry</label>
                        <input type="date"
                               class="form-control"
                               name="NewExpiry" />
                        <span class="text-danger" id="editExpiryError"></span>
                    </div>

                </form>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-warning" id="updateMedicine">Update</button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {

            // ===================== SUCCESS TOAST =====================

            function showSuccess(message) {
                $("#toastMessage").text(message);
                var toast = new bootstrap.Toast(document.getElementById('successToast'));
                toast.show();
            }

            // ===================== LOAD CATEGORIES (ADD) =====================

            $("#openAddModal").click(function () {

                $("#addMedicineModal").modal("show");

                $.get("/Pharmacist/GetCategories", function (data) {

                    $("#CategoryId").empty()
                        .append('<option value="">-- Select Category --</option>');

                    $.each(data, function (i, item) {
                        $("#CategoryId").append(
                            `<option value="${item.categoryId}">
                                ${item.categoryName}
                             </option>`
                        );
                    });
                });
            });

            // ===================== ADD MEDICINE =====================

            $("#saveMedicine").click(function () {

                // Clear previous errors
                $("#quantityError").text("");
                $("#priceError").text("");
                $("#expiryError").text("");

                var formData = $("#addMedicineForm").serialize();

                $.ajax({
                    url: "/Pharmacist/AddMedicine",
                    type: "POST",
                    data: formData,
                    success: function (response) {

                        if (response.success) {

                                $("#editMedicineModal").modal("hide");

        showSuccess("Medicine updated successfully!");

        setTimeout(function () {
            location.reload();
        }, 1500);
                        }
                                else if (response.errors) {

            $("#quantityError").text("");
            $("#priceError").text("");
            $("#expiryError").text("");

            if (response.errors.Quantity) {
                $("#quantityError").text(response.errors.Quantity[0]);
            }

            if (response.errors.Price) {
                $("#priceError").text(response.errors.Price[0]);
            }

            if (response.errors.ExpiryDate) {
                $("#expiryError").text(response.errors.ExpiryDate[0]);
            }
        }
                    },
                    error: function () {
                        alert("Server error occurred.");
                    }
                });
            });

            // ===================== EDIT BUTTON =====================

            $(document).on("click", ".editBtn", function () {

                let btn = $(this);

                $("#EditMedicineId").val(btn.data("id"));
                $("#EditMedicineName").val(btn.data("name"));
                $("#EditDescription").val(btn.data("description"));
                $("#EditCurrentStock").val(btn.data("stock"));
                $("#EditCurrentPrice").val(btn.data("price"));
                $("#EditCurrentExpiry").val(btn.data("expiry"));

                let selectedCategory = btn.data("categoryid");

                $.get("/Pharmacist/GetCategories", function (data) {

                    $("#EditCategoryId").empty();

                    $.each(data, function (i, item) {

                        let selected = item.categoryId == selectedCategory ? "selected" : "";

                        $("#EditCategoryId").append(
                            `<option value="${item.categoryId}" ${selected}>
                                ${item.categoryName}
                             </option>`
                        );
                    });
                });

                $("#editMedicineModal").modal("show");
            });

            // ===================== UPDATE MEDICINE =====================

                   $("#updateMedicine").click(function () {

            $("#editStockError").text("");
            $("#editPriceError").text("");
            $("#editExpiryError").text("");

            var formData = $("#editMedicineForm").serialize();

            $.ajax({
                url: "/Pharmacist/UpdateMedicine",
                type: "POST",
                data: formData,
                success: function (response) {

                    console.log("Update Response:", response);

                    if (response.success === true) {

                        $("#editMedicineModal").modal("hide");
                        showSuccess("Medicine updated successfully!");

                        setTimeout(function () {
                            location.reload();
                        }, 1500);
                    }
                    else {

                        if (response.errors) {

                            if (response.errors.AddedQuantity) {
                                $("#editStockError").text(response.errors.AddedQuantity[0]);
                            }

                            if (response.errors.NewPrice) {
                                $("#editPriceError").text(response.errors.NewPrice[0]);
                            }

                            if (response.errors.NewExpiry) {
                                $("#editExpiryError").text(response.errors.NewExpiry[0]);
                            }
                        }
                    }
                },
                error: function (xhr) {
                    console.log("Server Error:", xhr.responseText);
                }
            });
        });

        });
    </script>
}