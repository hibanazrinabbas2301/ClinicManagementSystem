@model IEnumerable<ClinicManagementSystem.ViewModel.MedicineViewModel>

@{
    ViewData["Title"] = "Pharmacy Inventory";
}

<div class="container mt-4">

    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Pharmacy Inventory</h2>

        <button type="button"
                class="btn btn-success"
                id="openAddModal">
            <i class="bi bi-plus-circle"></i> Add Medicine
        </button>


    </div>

    <!-- Inventory Table -->
    <div class="card shadow-sm">
        <div class="card-body">

            <table class="table table-bordered table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Medicine Name</th>
                        <th>Description</th>
                        <th>Category</th>
                        <th>Stock</th>
                        <th>Expiry Date</th>
                        <th>Price</th>
                        <th width="150">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.MedicineName</td>
                                <td>@item.MedicineDescription</td>
                                <td>@item.CategoryName</td>
                                <td>@item.CurrentStock</td>
                                <td>@item.ExpiryDate.ToString("dd-MM-yyyy")</td>
                                <td>@item.Price.ToString("0.00")</td>

                                <td>
                                    <button class="btn btn-sm btn-primary me-2 editBtn"
                                            data-id="@item.MedicineId"
                                            data-name="@item.MedicineName"
                                            data-description="@item.MedicineDescription"
                                            data-categoryid="@item.CategoryId"
                                            data-stock="@item.CurrentStock"
                                            data-price="@item.Price"
                                            data-expiry="@item.ExpiryDate.ToString("yyyy-MM-dd")">
                                        Edit
                                    </button>

                                   
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center">
                                No medicines available.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>



    <!-- Add Medicine Modal -->
    <div class="modal fade" id="addMedicineModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Add Medicine</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">

                    <form id="addMedicineForm">

                        <div class="mb-3">
                            <label>Medicine Name</label>
                            <input type="text"
                                   class="form-control"
                                   name="MedicineName"
                                   required />
                        </div>

                        <div class="mb-3">
                            <label>Description</label>
                            <textarea class="form-control"
                                      name="Description"></textarea>
                        </div>

                        <div class="mb-3">
                            <label>Category</label>
                            <select class="form-control"
                                    name="CategoryId"
                                    id="CategoryId"
                                    required>
                                <option value="">-- Select Category --</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label>Stock</label>
                            <input type="number"
                                   class="form-control"
                                   name="Quantity"
                                   required />
                        </div>

                        <div class="mb-3">
                            <label>Expiry Date</label>
                            <input type="date"
                                   class="form-control"
                                   name="ExpiryDate"
                                   required />
                        </div>

                        <div class="mb-3">
                            <label>Price</label>
                            <input type="number"
                                   step="0.01"
                                   class="form-control"
                                   name="Price"
                                   required />
                        </div>

                    </form>

                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="button"
                            class="btn btn-primary"
                            id="saveMedicine">
                        Save
                    </button>
                </div>

            </div>
        </div>
    </div>

    <!-- Edit Medicine Modal -->
    <div class="modal fade" id="editMedicineModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Edit Medicine</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">

                    <form id="editMedicineForm">

                        <input type="hidden" name="MedicineId" id="EditMedicineId" />

                        <div class="mb-3">
                            <label>Medicine Name</label>
                            <input type="text"
                                   class="form-control"
                                   name="MedicineName"
                                   id="EditMedicineName" />
                        </div>

                        <div class="mb-3">
                            <label>Description</label>
                            <textarea class="form-control"
                                      name="MedicineDescription"
                                      id="EditDescription">
                            </textarea>
                        </div>


                        <div class="mb-3">
                            <label>Category</label>
                            <select class="form-control"
                                    name="CategoryId"
                                    id="EditCategoryId">
                            </select>
                        </div>

                        <div class="mb-3">
                            <label>Current Stock</label>
                            <input type="text"
                                   class="form-control"
                                   id="EditCurrentStock"
                                   readonly />
                        </div>

                        <div class="mb-3">
                            <label>Add Stock</label>
                            <input type="number"
                                   class="form-control"
                                   name="AddedQuantity"
                                   value="0" />
                        </div>

                        <div class="mb-3">
                            <label>Current Price</label>
                            <input type="text"
                                   class="form-control"
                                   id="EditCurrentPrice"
                                   readonly />
                        </div>

                        <div class="mb-3">
                            <label>New Price (Optional)</label>
                            <input type="number"
                                   step="0.01"
                                   class="form-control"
                                   name="NewPrice" />
                        </div>

                        <div class="mb-3">
                            <label>Current Expiry</label>
                            <input type="text"
                                   class="form-control"
                                   id="EditCurrentExpiry"
                                   readonly />
                        </div>

                        <div class="mb-3">
                            <label>New Expiry (Optional)</label>
                            <input type="date"
                                   class="form-control"
                                   name="NewExpiry" />
                        </div>

                    </form>

                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="button"
                            class="btn btn-warning"
                            id="updateMedicine">
                        Update
                    </button>
                </div>

            </div>
        </div>
    </div>


</div>
@section Scripts {
    <script>
        $(document).ready(function () {

            // ------------------ ADD MEDICINE ------------------

            $("#openAddModal").click(function () {

                $("#addMedicineModal").modal("show");

                $.get("/Pharmacist/GetCategories", function (data) {

                    $("#CategoryId").empty();
                    $("#CategoryId").append('<option value="">-- Select Category --</option>');

                    $.each(data, function (i, item) {
                        $("#CategoryId").append(
                            `<option value="${item.categoryId}">
                                ${item.categoryName}
                            </option>`
                        );
                    });
                });
            });

            $("#saveMedicine").click(function () {

                var formData = $("#addMedicineForm").serialize();

                $.ajax({
                    url: "/Pharmacist/Index",
                    type: "POST",
                    data: formData,
                    success: function (response) {

                        if (response.success) {
                            location.reload();
                        }
                        else {
                            alert("Validation failed");
                        }
                    }
                });
            });


            // ------------------ EDIT BUTTON ------------------

            $(document).on("click", ".editBtn", function () {

                var button = $(this);

                $("#EditMedicineId").val(button.data("id"));
                $("#EditMedicineName").val(button.data("name"));
                $("#EditDescription").val(button.data("description"));
                $("#EditCurrentStock").val(button.data("stock"));
                $("#EditCurrentPrice").val(button.data("price"));
                $("#EditCurrentExpiry").val(button.data("expiry"));

                var selectedCategory = button.data("categoryid");

                $.get("/Pharmacist/GetCategories", function (data) {

                    $("#EditCategoryId").empty();

                    $.each(data, function (i, item) {

                        var selected = item.categoryId == selectedCategory ? "selected" : "";

                        $("#EditCategoryId").append(
                            `<option value="${item.categoryId}" ${selected}>
                                ${item.categoryName}
                            </option>`
                        );
                    });

                });

                $("#editMedicineModal").modal("show");
            });


            // ------------------ UPDATE BUTTON (MOVED OUTSIDE) ------------------

                    $("#updateMedicine").click(function () {

            var formData = $("#editMedicineForm").serialize();

            $.ajax({
                url: "/Pharmacist/UpdateMedicine",
                type: "POST",
                data: formData,
                success: function (response) {

                    if (response.success) {

                        alert(response.message);   // ✅ Success message

                        $("#editMedicineModal").modal("hide");

                        location.reload(); // optional (keeps things simple)

                    } else {
                        alert(response.message);
                    }
                },
                error: function () {
                    alert("Something went wrong!");
                }
            });
        });


        });
    </script>
}


