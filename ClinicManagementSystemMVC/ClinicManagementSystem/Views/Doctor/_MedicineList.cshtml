@model List<ClinicManagementSystem.Models.MedicinePrescription>

<h5 class="mt-3">📌 Prescribed Medicines</h5>

<table class="table table-sm table-bordered">
    <tr class="table-dark">
        <th>Medicine</th>
        <th>Qty</th>
        <th>Frequency</th>
        <th>Days</th>
    </tr>

    @foreach (var m in Model)
    {
        <tr>
            <td>@m.MedicineName</td>
            <td>@m.Quantity</td>
            <td>@m.Frequency</td>
            <td>@m.DurationDays</td>
        </tr>
    }
</table>
