@model ClinicManagementSystem.Models.Diagnosis

@{
    ViewData["Title"] = "Consultation";
}

<!-- ============================= -->
<!-- ✅ Page Header -->
<!-- ============================= -->
<div class="mb-4">
    <h2 class="fw-bold text-primary">
        👨‍⚕️ Doctor Consultation Panel
    </h2>
    <p class="text-muted mb-0">
        Manage Diagnosis, Prescriptions, Lab Tests & Patient History
    </p>
</div>

<hr />

<!-- ============================= -->
<!-- ✅ Alerts -->
<!-- ============================= -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm">
        <strong>Success:</strong> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm">
        <strong>Error:</strong> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- ============================= -->
<!-- ✅ Patient Basic Details -->
<!-- ============================= -->
@{
    var patient = ViewBag.PatientInfo as ClinicManagementSystem.View_Model.PatientBasicInfo;
}

@if (patient != null)
{
    <div class="card shadow-sm border-0 rounded-4 mb-4">
        <div class="card-header bg-info text-white rounded-top-4">
            <h5 class="mb-0">👤 Patient Basic Details</h5>
        </div>

        <div class="card-body row text-center">

            <div class="col-md-3">
                <h6 class="text-muted">Name</h6>
                <p class="fw-bold">@patient.PatientName</p>
            </div>

            <div class="col-md-3">
                <h6 class="text-muted">Age</h6>
                <p class="fw-bold">@patient.Age</p>
            </div>

            <div class="col-md-3">
                <h6 class="text-muted">Gender</h6>
                <p class="fw-bold">@patient.Gender</p>
            </div>

            <div class="col-md-3">
                <h6 class="text-muted">Blood Group</h6>
                <p class="fw-bold text-danger">@patient.BloodGroup</p>
            </div>

        </div>
    </div>
}

<!-- ============================= -->
<!-- ✅ Diagnosis Section -->
<!-- ============================= -->
<div class="card shadow-lg border-0 rounded-4 mb-4">
    <div class="card-header bg-success text-white rounded-top-4">
        <h5 class="mb-0">📝 Diagnosis Details</h5>
    </div>

    <div class="card-body">

        <form asp-action="AddDiagnosis" method="post">

            <input asp-for="AppointmentId" type="hidden" />
            <input asp-for="PatientId" type="hidden" />

            <!-- Symptoms -->
            <div class="mb-3">
                <label class="fw-semibold">Symptoms</label>
                <textarea asp-for="Symptoms" class="form-control" rows="2"
                          placeholder="Enter patient symptoms..."></textarea>
                <span asp-validation-for="Symptoms" class="text-danger"></span>
            </div>

            <!-- Diagnosis -->
            <div class="mb-3">
                <label class="fw-semibold">Diagnosis</label>
                <textarea asp-for="DiagnosisText" class="form-control" rows="2"
                          placeholder="Enter diagnosis details..."></textarea>
                <span asp-validation-for="DiagnosisText" class="text-danger"></span>
            </div>

            <!-- Doctor Notes -->
            <div class="mb-3">
                <label class="fw-semibold">Doctor Notes</label>
                <textarea asp-for="DoctorNotes" class="form-control" rows="2"
                          placeholder="Enter doctor notes..."></textarea>
                <span asp-validation-for="DoctorNotes" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-success px-4 shadow-sm">
                💾 Save Diagnosis Draft
            </button>
        </form>
    </div>
</div>

<!-- ============================= -->
<!-- ✅ Medicines + Lab Tests Section -->
<!-- ============================= -->
<div class="row">

    <!-- ============================= -->
    <!-- 💊 Medicines -->
    <!-- ============================= -->
    <!-- ============================= -->
    <!-- 💊 Medicines -->
    <!-- ============================= -->
    <div class="col-md-6 mb-4">
        <div class="card shadow-sm border-0 rounded-4 h-100">
            <div class="card-header bg-primary text-white rounded-top-4">
                <h5 class="mb-0">💊 Add Medicines</h5>
            </div>

            <div class="card-body">

                <form asp-action="AddMedicinePrescription" method="post">

                    <input type="hidden" name="AppointmentId" value="@Model.AppointmentId" />
                    <input type="hidden" name="PatientId" value="@Model.PatientId" />

                    <!-- Medicine Dropdown -->
                    <div class="mb-3">
                        <label class="fw-semibold">Select Medicine</label>
                        <select name="MedicineId" class="form-select" required>
                            <option value="0">-- Select Medicine --</option>
                            @foreach (var med in ViewBag.Medicines)
                            {
                                <option value="@med.MedicineId">
                                    @med.MedicineName
                                </option>
                            }
                        </select>
                    </div>

                    <!-- Dosage -->
                    <div class="mb-3">
                        <label class="fw-semibold">Dosage</label>
                        <input type="text"
                               name="Dosage"
                               class="form-control"
                               placeholder="Eg: 500mg / 10ml"
                               required />
                    </div>

                    <!-- Frequency Dropdown -->
                    <div class="mb-3">
                        <label class="fw-semibold">Frequency (Times Per Day)</label>
                        <select name="Frequency" class="form-select" required>
                            <option value="0">-- Select Frequency --</option>
                            <option value="1">Once Daily</option>
                            <option value="2">Twice Daily</option>
                            <option value="3">Three Times Daily</option>
                            <option value="4">Four Times Daily</option>
                        </select>
                    </div>

                    <!-- Duration -->
                    <div class="mb-3">
                        <label class="fw-semibold">Duration (Days)</label>
                        <input type="number"
                               name="DurationDays"
                               class="form-control"
                               min="1"
                               required />
                    </div>

                    <button class="btn btn-primary w-100 shadow-sm">
                        ➕ Add Medicine
                    </button>
                </form>

                <!-- Prescribed Medicines -->
                <h6 class="mt-4 fw-bold">📌 Prescribed Medicines</h6>

                @if (ViewBag.MedicineList.Count == 0)
                {
                    <p class="text-muted">No medicines prescribed yet.</p>
                }
                else
                {
                    <table class="table table-sm table-hover mt-2">
                        <thead class="table-light">
                            <tr>
                                <th>Medicine</th>
                                <th>Qty</th>
                                <th>Dosage</th>
                                <th>Frequency</th>
                                <th>Days</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in ViewBag.MedicineList)
                            {
                                <tr>
                                    <td>@m.MedicineName</td>
                                    <td>@m.Quantity</td>
                                    <td>@m.Dosage</td>
                                    <td>@m.Frequency Times/Day</td>
                                    <td>@m.DurationDays</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

            </div>
        </div>
    </div>

    <!-- ============================= -->
    <!-- 🧪 Lab Tests -->
    <!-- ============================= -->
    <div class="col-md-6 mb-4">
        <div class="card shadow-sm border-0 rounded-4 h-100">
            <div class="card-header bg-danger text-white rounded-top-4">
                <h5 class="mb-0">🧪 Add Lab Tests</h5>
            </div>

            <div class="card-body">

                <form asp-action="AddLabPrescription" method="post">

                    <input type="hidden" name="AppointmentId" value="@Model.AppointmentId" />
                    <input type="hidden" name="PatientId" value="@Model.PatientId" />

                    <label><b>Select Lab Test (Optional)</b></label>
                    <select name="TestId" class="form-select">
                        <option value="">-- Select Test (If Needed) --</option>
                        @foreach (var t in ViewBag.LabTests)
                        {
                            <option value="@t.TestId">@t.TestName</option>
                        }
                    </select>

                    <button class="btn btn-danger mt-3 w-100">
                        ➕ Add Lab Test
                    </button>
                </form>

                <!-- Prescribed Lab Tests -->
                <h6 class="mt-4 fw-bold">📌 Prescribed Lab Tests</h6>

                @if (ViewBag.LabList.Count == 0)
                {
                    <p class="text-muted">No lab tests prescribed yet.</p>
                }
                else
                {
                    <table class="table table-sm table-hover mt-2">
                        <thead class="table-light">
                            <tr>
                                <th>Test Name</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var l in ViewBag.LabList)
                            {
                                <tr>
                                    <td>@l.TestName</td>
                                    <td>
                                        <span class="badge bg-info">@l.Status</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

            </div>
        </div>
    </div>
</div>
<h4 class="mt-4">🧪 Lab Results</h4>

@if (ViewBag.LabResults != null && ViewBag.LabResults.Count > 0)
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Test</th>
                <th>Result</th>
                <th>Normal Range</th>
                <th>Remarks</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in ViewBag.LabResults)
            {
                <tr>
                    <td>@item.TestName</td>
                    <td>
                        @(item.ActualValue ?? "Pending")
                    </td>
                    <td>@item.NormalRange</td>
                    <td>@item.Remarks</td>
                    <td>@item.Status</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-warning">
        No Lab Tests Prescribed.
    </div>
}

<!-- ============================= -->
<!-- ✅ Patient History -->
<!-- ============================= -->
<div class="card shadow-sm border-0 rounded-4 mb-4">
    <div class="card-header bg-dark text-white rounded-top-4">
        <h5 class="mb-0">📜 Patient Consultation History</h5>
    </div>

    <div class="card-body">

        @if (ViewBag.History.Count == 0)
        {
            <p class="text-muted">No previous consultation history found.</p>
        }
        else
        {
            <table class="table table-hover table-sm">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Symptoms</th>
                        <th>Diagnosis</th>
                        <th>Notes</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var h in ViewBag.History)
                    {
                        <tr>
                            <td>@h.Date.ToShortDateString()</td>
                            <td>@h.Symptoms</td>
                            <td>@h.DiagnosisText</td>
                            <td>@h.DoctorNotes</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

    </div>
</div>
<div class="card shadow-sm border-0 rounded-4 mb-4">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">💊 Medicine History</h5>
    </div>

    <div class="card-body">
        @if (ViewBag.MedicineHistory.Count == 0)
        {
            <p class="text-muted">No previous medicines prescribed.</p>
        }
        else
        {
            <table class="table table-sm table-hover">
                <thead>
                    <tr>
                        <th>Medicine</th>
                        <th>Dosage</th>
                        <th>Qty</th>
                        <th>Frequency</th>
                        <th>Days</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var med in ViewBag.MedicineHistory)
                    {
                        <tr>
                            <td>@med.MedicineName</td>
                            <td>@med.Dosage</td>
                            <td>@med.Quantity</td>
                            <td>@med.Frequency</td>
                            <td>@med.DurationDays</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
<div class="card shadow-sm border-0 rounded-4 mb-4">
    <div class="card-header bg-danger text-white">
        <h5 class="mb-0">🧪 Lab Test Results</h5>
    </div>

    <div class="card-body">
        @if (ViewBag.LabHistory.Count == 0)
        {
            <p class="text-muted">No lab tests prescribed yet.</p>
        }
        else
        {
            <table class="table table-sm table-hover">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Test</th>
                        <th>Status</th>
                        <th>Result</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var lab in ViewBag.LabHistory)
                    {
                        <tr>
                            <td>@lab.PrescribedDate.ToShortDateString()</td>
                            <td>@lab.TestName</td>

                            <td>
                                <span class="badge bg-info">@lab.Status</span>
                            </td>

                            <td>
                                @if (lab.ResultText == null)
                                {
                                    <span class="text-muted">Pending</span>
                                }
                                else
                                {
                                    <span class="text-success fw-bold">
                                        @lab.ResultText
                                    </span>

                                    <br />
                                    <small class="text-muted">
                                        Updated: @lab.ResultDate?.ToShortDateString()
                                    </small>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>



<!-- ============================= -->
<!-- ✅ Finish Consultation -->
<!-- ============================= -->
<div class="card shadow-lg border-0 rounded-4">
    <div class="card-body text-center">

        <form asp-action="FinalSaveConsultation" method="post">
            <input type="hidden" name="appointmentId" value="@Model.AppointmentId" />
            <input type="hidden" name="patientId" value="@Model.PatientId" />

            <button class="btn btn-dark btn-lg w-100 shadow-sm">
                ✅ Complete Consultation & Close Appointment
            </button>
        </form>

        <a asp-action="Index" class="btn btn-outline-secondary w-100 mt-3">
            ⬅ Back to Dashboard
        </a>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
