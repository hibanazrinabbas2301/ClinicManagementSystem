@model ClinicManagementSystem.Models.Diagnosis

<h2 class="mb-3">👨‍⚕️ Consultation Page</h2>

<!-- Alerts -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<hr />

<!-- ========================= -->
<!-- ✅ Diagnosis Section -->
<!-- ========================= -->
<h4 class="text-success">📝 Diagnosis Details</h4>

<form asp-action="AddDiagnosis" method="post">

    <input asp-for="AppointmentId" type="hidden" />
    <input asp-for="PatientId" type="hidden" />

    <!-- Symptoms -->
    <label><b>Symptoms</b></label>
    <textarea asp-for="Symptoms" class="form-control"></textarea>
    <span asp-validation-for="Symptoms" class="text-danger"></span>

    <!-- Diagnosis -->
    <label class="mt-2"><b>Diagnosis</b></label>
    <textarea asp-for="DiagnosisText" class="form-control"></textarea>
    <span asp-validation-for="DiagnosisText" class="text-danger"></span>

    <!-- Doctor Notes -->
    <label class="mt-2"><b>Doctor Notes</b></label>
    <textarea asp-for="DoctorNotes" class="form-control"></textarea>
    <span asp-validation-for="DoctorNotes" class="text-danger"></span>

    <button type="submit" class="btn btn-outline-success mt-3">
        💾 Save Diagnosis Draft
    </button>
</form>

<hr />

<!-- ========================= -->
<!-- ✅ Medicine Prescription -->
<!-- ========================= -->
<h4 class="text-primary">💊 Add Medicines</h4>

<form asp-action="AddMedicinePrescription" method="post">

    <input type="hidden" name="AppointmentId" value="@Model.AppointmentId" />
    <input type="hidden" name="PatientId" value="@Model.PatientId" />

    <label><b>Select Medicine</b></label>
    <select name="MedicineId" class="form-control" required>
        <option value="">-- Select Medicine --</option>
        @foreach (var med in ViewBag.Medicines)
        {
            <option value="@med.MedicineId">@med.MedicineName</option>
        }
    </select>

    <label class="mt-2"><b>Quantity</b></label>
    <input type="number" name="Quantity" class="form-control" min="1" required />

    <label class="mt-2"><b>Frequency</b></label>
    <input type="text" name="Frequency" class="form-control"
           placeholder="Eg: Morning & Night" required />

    <label class="mt-2"><b>Duration (Days)</b></label>
    <input type="number" name="DurationDays" class="form-control" min="1" required />

    <button class="btn btn-primary mt-3">
        ➕ Add Medicine
    </button>
</form>

<!-- Display Medicines -->
<h5 class="mt-4">📌 Prescribed Medicines</h5>

@if (ViewBag.MedicineList.Count == 0)
{
    <p class="text-muted">No medicines prescribed yet.</p>
}
else
{
    <table class="table table-bordered table-sm">
        <tr class="table-dark">
            <th>Medicine</th>
            <th>Qty</th>
            <th>Frequency</th>
            <th>Days</th>
        </tr>

        @foreach (var m in ViewBag.MedicineList)
        {
            <tr>
                <td>@m.MedicineName</td>
                <td>@m.Quantity</td>
                <td>@m.Frequency</td>
                <td>@m.DurationDays</td>
            </tr>
        }
    </table>
}

<hr />

<!-- ========================= -->
<!-- ✅ Lab Prescription -->
<!-- ========================= -->
<h4 class="text-danger">🧪 Add Lab Tests</h4>

<form asp-action="AddLabPrescription" method="post">

    <input type="hidden" name="AppointmentId" value="@Model.AppointmentId" />
    <input type="hidden" name="PatientId" value="@Model.PatientId" />

    <label><b>Select Lab Test</b></label>
    <select name="TestId" class="form-control" required>
        <option value="">-- Select Test --</option>
        @foreach (var t in ViewBag.LabTests)
        {
            <option value="@t.TestId">@t.TestName</option>
        }
    </select>

    <label class="mt-2"><b>Quantity</b></label>
    <input type="number" name="Quantity" class="form-control" min="1" required />

    <button class="btn btn-danger mt-3">
        ➕ Add Lab Test
    </button>
</form>

<!-- Display Lab Tests -->
<h5 class="mt-4">📌 Prescribed Lab Tests</h5>

@if (ViewBag.LabList.Count == 0)
{
    <p class="text-muted">No lab tests prescribed yet.</p>
}
else
{
    <table class="table table-bordered table-sm">
        <tr class="table-dark">
            <th>Test</th>
            <th>Qty</th>
            <th>Status</th>
        </tr>

        @foreach (var l in ViewBag.LabList)
        {
            <tr>
                <td>@l.TestName</td>
                <td>@l.Quantity</td>
                <td>@l.Status</td>
            </tr>
        }
    </table>
}

<hr />

<!-- ========================= -->
<!-- ✅ Patient History -->
<!-- ========================= -->
<h4>📜 Patient Consultation History</h4>

@if (ViewBag.History.Count == 0)
{
    <p class="text-muted">No previous consultation history found.</p>
}
else
{
    <table class="table table-bordered table-sm">
        <tr class="table-dark">
            <th>Date</th>
            <th>Symptoms</th>
            <th>Diagnosis</th>
            <th>Notes</th>
        </tr>

        @foreach (var h in ViewBag.History)
        {
            <tr>
                <td>@h.Date.ToShortDateString()</td>
                <td>@h.Symptoms</td>
                <td>@h.DiagnosisText</td>
                <td>@h.DoctorNotes</td>
            </tr>
        }
    </table>
}

<hr />

<!-- ========================= -->
<!-- ✅ FINAL COMPLETE CONSULTATION -->
<!-- ========================= -->
<h4 class="text-dark">✅ Finish Consultation</h4>

<form asp-action="FinalSaveConsultation" method="post">
    <input type="hidden" name="appointmentId" value="@Model.AppointmentId" />
    <input type="hidden" name="patientId" value="@Model.PatientId" />

    <button class="btn btn-dark btn-lg w-100 mt-3">
        ✅ Complete Consultation & Close Appointment
    </button>
</form>

<br />

<a asp-action="Index" class="btn btn-secondary w-100">
    ⬅ Back to Dashboard
</a>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
