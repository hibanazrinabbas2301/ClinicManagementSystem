@model List<ClinicManagementSystem.Models.LabPrescription>

<h5 class="mt-3">📌 Prescribed Lab Tests</h5>

<table class="table table-sm table-bordered">
    <tr class="table-dark">
        <th>Test</th>
        <th>Qty</th>
        <th>Status</th>
    </tr>

    @foreach (var l in Model)
    {
        <tr>
            <td>@l.TestName</td>
            <td>@l.Quantity</td>
            <td>@l.Status</td>
        </tr>
    }
</table>
