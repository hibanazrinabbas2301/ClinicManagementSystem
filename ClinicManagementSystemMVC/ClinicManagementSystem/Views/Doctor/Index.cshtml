@model List<ClinicManagementSystem.Models.Appointment>

@{
    ViewData["Title"] = "Doctor Dashboard";
}

<!-- ================= HEADER ================= -->
<div class="page-header mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

        <div>
            <h2 class="fw-bold mb-1">Doctor Dashboard</h2>
            <p class="text-muted mb-0">
                Today's Appointments - @DateTime.Now.ToString("dddd, dd MMM yyyy")
            </p>
        </div>

        <div class="dashboard-card text-center px-4 py-3">
            <small class="text-muted">Total Appointments</small>
            <h4 class="fw-bold mb-0">@Model.Count</h4>
        </div>

    </div>
</div>

<!-- ================= ALERTS ================= -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success shadow-sm">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger shadow-sm">
        @TempData["Error"]
    </div>
}

@if (Model.Count == 0)
{
    <!-- ================= EMPTY STATE ================= -->
    <div class="card shadow-sm text-center p-5">
        <i class="bi bi-calendar-x fs-1 text-muted mb-3"></i>
        <h5>No Appointments Today</h5>
        <p class="text-muted mb-0">
            You have no scheduled consultations for today.
        </p>
    </div>
}
else
{
    <!-- ================= SUMMARY CARDS ================= -->
    <div class="row mb-4 g-4">

        <div class="col-md-4">
            <div class="dashboard-card text-center">
                <small class="text-muted">Upcoming</small>
                <h3 class="fw-bold text-success">
                    @Model.Count(x => x.Status == "Upcoming")
                </h3>
            </div>
        </div>

        <div class="col-md-4">
            <div class="dashboard-card text-center">
                <small class="text-muted">Completed</small>
                <h3 class="fw-bold text-primary">
                    @Model.Count(x => x.Status == "Completed")
                </h3>
            </div>
        </div>

        <div class="col-md-4">
            <div class="dashboard-card text-center">
                <small class="text-muted">Expired</small>
                <h3 class="fw-bold text-danger">
                    @Model.Count(x => x.Status == "Expired")
                </h3>
            </div>
        </div>

    </div>

    <!-- ================= TABLE ================= -->
    <div class="card shadow-sm">
        <div class="card-body p-0">

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 text-center">

                    <thead>
                        <tr>
                            <th>Token</th>
                            <th>Patient Name</th>
                            <th>Time Slot</th>
                            <th>Status</th>
                            <th style="width:180px;">Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            string rowClass = item.Status == "Expired"
                            ? "table-danger"
                            : item.Status == "Completed"
                            ? "table-secondary"
                            : "";

                            <tr class="@rowClass">

                                <td class="fw-bold">
                                    @item.TokenNumber
                                </td>

                                <td class="fw-semibold">
                                    @item.PatientName
                                </td>

                                <td>
                                    <small class="text-muted">
                                        @item.StartTime - @item.EndTime
                                    </small>
                                </td>

                                <td>
                                    @if (item.Status == "Expired")
                                    {
                                        <span class="badge bg-danger">
                                            Expired
                                        </span>
                                    }
                                    else if (item.Status == "Completed")
                                    {
                                        <span class="badge bg-secondary">
                                            Completed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            Upcoming
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (item.Status == "Completed")
                                    {
                                        <button class="btn btn-success btn-sm w-100" disabled>
                                            Consulted
                                        </button>
                                    }
                                    else if (item.Status == "Upcoming")
                                    {
                                        <a class="btn btn-primary btn-sm w-100"
                                           asp-action="Consultation"
                                           asp-route-appointmentId="@item.AppointmentId"
                                           asp-route-patientId="@item.PatientId">
                                            Start Consultation
                                        </a>
                                    }
                                    else
                                    {
                                        <button class="btn btn-outline-secondary btn-sm w-100" disabled>
                                            Expired
                                        </button>
                                    }
                                </td>

                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>
}