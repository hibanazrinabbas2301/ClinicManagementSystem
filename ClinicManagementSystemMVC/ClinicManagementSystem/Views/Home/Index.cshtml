@{
    ViewData["Title"] = "Home Page";
}
@{
    ViewData["Title"] = "Pharmacist Dashboard";
}

<div class="container mt-4">
    <h2 class="mb-4 text-center">Pharmacist Dashboard</h2>

    <div class="row g-4">

        <!-- Inventory Management -->
        <div class="col-md-4">
            <div class="card shadow-lg border-0 h-100 text-center">
                <div class="card-body">
                    <div class="mb-3">
                        <i class="bi bi-capsule-pill text-primary" style="font-size: 3rem;"></i>
                    </div>
                    <h5 class="card-title">Inventory Management</h5>
                    <p class="card-text">
                        Manage medicines, stock levels, expiry dates and pricing.
                    </p>
                    <a asp-controller="Pharmacist"
                       asp-action="Index"
                       class="btn btn-primary w-100">
                        Go to Inventory
                    </a>
                </div>
            </div>
        </div>

        <!-- Pending Prescriptions -->
        <div class="col-md-4">
            <div class="card shadow-lg border-0 h-100 text-center">
                <div class="card-body">
                    <div class="mb-3">
                        <i class="bi bi-file-medical text-warning" style="font-size: 3rem;"></i>
                    </div>
                    <h5 class="card-title">Pending Prescriptions</h5>
                    <p class="card-text">
                        View and issue medicines prescribed by doctors.
                    </p>
                    <a asp-controller="Prescription"
                       asp-action="Index"
                       class="btn btn-warning w-100 text-white">
                        View Prescriptions
                    </a>


                </div>
            </div>
        </div>

        <!-- Billing -->
        <div class="col-md-4">
            <div class="card shadow-lg border-0 h-100 text-center">
                <div class="card-body">
                    <div class="mb-3">
                        <i class="bi bi-receipt text-success" style="font-size: 3rem;"></i>
                    </div>
                    <h5 class="card-title">Billing</h5>
                    <p class="card-text">
                        Generate bills and view billing history.
                    </p>
                    <a asp-controller="Pharmacist"
                       asp-action="Billing"
                       class="btn btn-success w-100">
                        Go to Billing
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>
