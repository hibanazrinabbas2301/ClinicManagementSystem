@{
    ViewData["Title"] = "Pharmacist Dashboard";
}

<!-- ================= PAGE HEADER ================= -->
<div class="page-header mb-5 text-center">
    <h2 class="fw-bold mb-1">Pharmacist Dashboard</h2>
    <p class="text-muted mb-0">
        Manage pharmacy operations efficiently
    </p>
</div>

<!-- ================= DASHBOARD CARDS ================= -->
<div class="row g-4 justify-content-center">

    <!-- Inventory Management -->
    <div class="col-md-4">
        <div class="dashboard-card text-center h-100">

            <div class="dashboard-icon mx-auto mb-3">
                <i class="bi bi-capsule-pill"></i>
            </div>

            <h5 class="fw-bold">Inventory Management</h5>

            <p class="text-muted mb-4">
                Manage medicines, stock levels, expiry dates and pricing.
            </p>

            <a asp-controller="Pharmacist"
               asp-action="Index"
               class="btn btn-primary w-100">
                Go to Inventory
            </a>
        </div>
    </div>

    <!-- Pending Prescriptions -->
    <div class="col-md-4">
        <div class="dashboard-card text-center h-100">

            <div class="dashboard-icon mx-auto mb-3">
                <i class="bi bi-file-medical"></i>
            </div>

            <h5 class="fw-bold">Pending Prescriptions</h5>

            <p class="text-muted mb-4">
                Review and issue medicines prescribed by doctors.
            </p>

            <a asp-controller="Prescription"
               asp-action="Index"
               class="btn btn-primary w-100">
                View Prescriptions
            </a>
        </div>
    </div>

</div>