@* @{
    ViewData["Title"] = "Dashboard";

    var role = Context.Session.GetString("UserRole");
    var userName = Context.Session.GetString("UserName");
}

<div class="page-header mb-5 text-center">
    <h2 class="fw-bold mb-2">
        Welcome, @userName 👋
    </h2>
    <p class="text-muted">
        Clinic Management System Overview
    </p>
</div>

<!-- ================= ROLE BASED ACCESS ================= -->
<div class="row g-4 justify-content-center mb-5">

    @if (role == "Receptionist")
    {
        <div class="col-md-4">
            <div class="dashboard-card text-center h-100">
                <div class="dashboard-icon mx-auto mb-3">
                    <i class="bi bi-people"></i>
                </div>
                <h5 class="fw-bold">Reception Panel</h5>
                <p class="text-muted mb-4">
                    Manage patients and appointments
                </p>
                <a asp-controller="Receptionist"
                   asp-action="Index"
                   class="btn btn-primary w-100">
                    Go to Reception
                </a>
            </div>
        </div>
    }

    @if (role == "Doctor")
    {
        <div class="col-md-4">
            <div class="dashboard-card text-center h-100">
                <div class="dashboard-icon mx-auto mb-3">
                    <i class="bi bi-heart-pulse"></i>
                </div>
                <h5 class="fw-bold">Doctor Panel</h5>
                <p class="text-muted mb-4">
                    View appointments and consultations
                </p>
                <a asp-controller="Doctor"
                   asp-action="Index"
                   class="btn btn-primary w-100">
                    Go to Doctor Panel
                </a>
            </div>
        </div>
    }

    @if (role == "Pharmacist")
    {
        <div class="col-md-4">
            <div class="dashboard-card text-center h-100">
                <div class="dashboard-icon mx-auto mb-3">
                    <i class="bi bi-capsule-pill"></i>
                </div>
                <h5 class="fw-bold">Pharmacy Panel</h5>
                <p class="text-muted mb-4">
                    Manage medicines and prescriptions
                </p>
                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-primary w-100">
                    Go to Pharmacy
                </a>
            </div>
        </div>
    }

    @if (role == "LabTechnician")
    {
        <div class="col-md-4">
            <div class="dashboard-card text-center h-100">
                <div class="dashboard-icon mx-auto mb-3">
                    <i class="bi bi-flask"></i>
                </div>
                <h5 class="fw-bold">Lab Panel</h5>
                <p class="text-muted mb-4">
                    Manage lab tests and reports
                </p>
                <a asp-controller="LabTechnicians"
                   asp-action="Index"
                   class="btn btn-primary w-100">
                    Go to Lab Panel
                </a>
            </div>
        </div>
    }

</div>

<!-- ================= QUICK ACCESS MODULES ================= -->
<div class="row g-4">

    <div class="col-md-4">
        <div class="dashboard-card text-center h-100">
            <div class="dashboard-icon mx-auto mb-3">
                <i class="bi bi-calendar-check"></i>
            </div>
            <h6 class="fw-bold">Appointments</h6>
            <p class="text-muted small">
                View and manage appointments
            </p>
        </div>
    </div>

    <div class="col-md-4">
        <div class="dashboard-card text-center h-100">
            <div class="dashboard-icon mx-auto mb-3">
                <i class="bi bi-file-earmark-medical"></i>
            </div>
            <h6 class="fw-bold">Prescriptions</h6>
            <p class="text-muted small">
                Review and manage prescriptions
            </p>
        </div>
    </div>

    <div class="col-md-4">
        <div class="dashboard-card text-center h-100">
            <div class="dashboard-icon mx-auto mb-3">
                <i class="bi bi-clipboard-data"></i>
            </div>
            <h6 class="fw-bold">Reports</h6>
            <p class="text-muted small">
                Access system reports
            </p>
        </div>
    </div>

</div> *@