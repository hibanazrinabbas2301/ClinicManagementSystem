@model IEnumerable<AppointmentViewModel>

@{
    ViewData["Title"] = "Today's Appointments";
}

<div class="container mt-4">
    <h2 class="text-center mb-4">Today's Appointments</h2>

    <!-- Alerts -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger text-center">@TempData["Error"]</div>
    }
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success text-center">@TempData["Message"]</div>
    }

    <!-- Navigation Buttons -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <a href="@Url.Action("Index", "Receptionist")" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Dashboard
            </a>

            <a asp-action="UpcomingAppointments" asp-controller="Receptionist"
               class="btn btn-outline-primary ms-2">
                View Upcoming
            </a>
        </div>
    </div>

    <!-- Search Form -->
    <form method="get"
          asp-action="AppointmentSearch"
          asp-controller="Receptionist"
          class="row g-2 mb-3">

        <div class="col-md-6">
            <input type="text"
                   name="searchText"
                   class="form-control"
                   placeholder="Search by Patient / MMR / Phone / Doctor"
                   value="@ViewBag.SearchText" />
        </div>

        <div class="col-md-3">
            <select name="type" class="form-select">
                <option value="ALL" selected="@(ViewBag.Type == "ALL")">Today + Upcoming</option>
                <option value="TODAY" selected="@(ViewBag.Type == "TODAY")">Only Today</option>
                <option value="UPCOMING" selected="@(ViewBag.Type == "UPCOMING")">Only Upcoming</option>
            </select>
        </div>

        <div class="col-md-3">
            <button type="submit" class="btn btn-primary w-100">
                Search
            </button>
        </div>

    </form>

    
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <!-- Book Appointment Button -->
    <div class="text-end mb-3">
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#bookAppointmentModal">
            Book New Appointment
        </button>
    </div>

    <!-- Appointment Table -->
    <table class="table table-bordered table-striped text-center">
        <thead class="table-dark">
            <tr>
                <th>Token</th>
                <th>Patient Name</th>
                <th>Doctor Name</th>
                <th>Appointment Date & Time</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var appointment in Model)
                {
                    <tr>
                        <td>@appointment.TokenNumber</td>
                        <td>@appointment.PatientName</td>
                        <td>@appointment.DoctorName</td>

                        <!-- ✅ Correct Date + Time Display -->
                        <td>
                            @appointment.SlotDate.ToString("dd/MM/yyyy")
                            @appointment.StartTime.ToString(@"hh\:mm") -
                            @appointment.EndTime.ToString(@"hh\:mm")
                        </td>

                        <td>@appointment.Status</td>

                        <td>
                            <form asp-action="GenerateConsultationBill"
                                  asp-controller="Receptionist"
                                  method="post">
                                @Html.AntiForgeryToken()

                                <input type="hidden" name="patientId" value="@appointment.PatientId" />
                                <input type="hidden" name="appointmentId" value="@appointment.AppointmentId" />
                                <input type="hidden" name="consultationFee" value="500" />

                                <button type="submit" class="btn btn-sm btn-success">
                                    Generate Bill
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-muted">
                        No appointments scheduled for today.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Book Appointment Modal -->
<div class="modal fade" id="bookAppointmentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="BookAppointment" asp-controller="Receptionist" method="post">
                @Html.AntiForgeryToken()

                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Book New Appointment</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">

                    <div class="mb-3">
                        <label class="form-label">Select Patient</label>
                        @Html.DropDownList(
                        "patientId",
                                                new SelectList(ViewBag.Patients, "PatientId", "PatientName"),
                                                "-- Select Patient --",
                                                new { @class = "form-select", required = "required" }
                                                )
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Select Date</label>
                        <input type="date"
                               id="slotDate"
                               name="slotDate"
                               class="form-control"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Select Slot</label>
                        <select id="slotId" name="slotId" class="form-select" required>
                            <option value="">-- Select Slot --</option>
                        </select>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        Cancel
                    </button>
                    <button type="submit" class="btn btn-success">
                        Book Appointment
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const dateInput = document.getElementById("slotDate");
        const slotDropdown = document.getElementById("slotId");

        if (!dateInput || !slotDropdown) return;

        dateInput.addEventListener("change", function () {

            const date = this.value;
            slotDropdown.innerHTML = '<option value="">-- Select Slot --</option>';

            if (!date) return;

            fetch(`/Receptionist/GetSlotsByDate?slotDate=${date}`)
                .then(res => res.json())
                .then(data => {
                    data.forEach(s => {
                        const opt = document.createElement("option");
                        opt.value = s.slotId;
                        opt.textContent = s.text;
                        slotDropdown.appendChild(opt);
                    });
                });
        });
    });
</script>