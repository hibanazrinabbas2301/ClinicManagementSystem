@model BillViewModel

@{
    ViewData["Title"] = "Consultation Bill";
}

<div class="container mt-4">
    <h2 class="text-center mb-4">Consultation Bill</h2>

    <div class="card p-3 shadow">
        <p><b>Appointment ID:</b> @Model.AppointmentId</p>
        <p><b>Patient:</b> @Model.PatientName</p>
        <p><b>Doctor:</b> @Model.DoctorName</p>
        <p><b>Date:</b> @Model.AppointmentDate.ToString("dd/MM/yyyy")</p>
        <p><b>Amount:</b> ₹@Model.TotalAmount</p>
        <p><b>Status:</b> @(Model.Paid ? "Paid" : "Unpaid")</p>
    </div>

    <div class="mt-3">
        <a class="btn btn-secondary" href="@Url.Action("TodayAppointments", "Receptionist")">Back</a>
    </div>
</div>
