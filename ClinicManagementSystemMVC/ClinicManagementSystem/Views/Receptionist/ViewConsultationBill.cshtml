@model BillViewModel

@{
    ViewData["Title"] = "Consultation Bill";
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="container mt-4">
    <h2 class="text-center mb-4">Consultation Bill</h2>

    <div class="card p-3 shadow">
        <p><b>Appointment ID:</b> @Model.AppointmentId</p>
        <p><b>Patient:</b> @Model.PatientName</p>
        <p><b>Doctor:</b> @Model.DoctorName</p>
        <p><b>Date:</b> @Model.AppointmentDate.ToString("dd/MM/yyyy")</p>
        <p><b>Amount:</b> ₹@Model.TotalAmount</p>
        <p><b>Status:</b> @(Model.Paid ? "Paid" : "Unpaid")</p>
    </div>

    <form asp-action="SendBillEmail" asp-controller="Receptionist" method="post" class="mt-4">
        @Html.AntiForgeryToken()

        <input type="hidden" name="appointmentId" value="@Model.AppointmentId" />

        <div class="mb-3">
            <label class="form-label">Send Bill To Email</label>
            <input type="email"
                   name="email"
                   class="form-control"
                   value="@Model.PatientEmail"
                   placeholder="Enter email or use patient email"
                   required />
            <small class="text-muted">
                You can use patient email or enter a different one.
            </small>
        </div>

        <button type="submit" class="btn btn-primary">
            <i class="bi bi-envelope"></i> Send Bill
        </button>
    </form>


    <div class="mt-3">
        <a class="btn btn-secondary" href="@Url.Action("TodayAppointments", "Receptionist")">Back</a>
    </div>
</div>
