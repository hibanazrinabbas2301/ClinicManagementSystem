@{
    ViewData["Title"] = "Receptionist Dashboard";
}

<div class="dashboard-header mb-4">
    <h2 class="fw-bold">Receptionist Dashboard</h2>
    <p class="text-muted">
        Manage patients and oversee today's appointments efficiently.
    </p>
</div>

<div class="row g-4">

    <!-- Manage Patients -->
    <div class="col-md-6">
        <div class="dashboard-card h-100">
            <div class="d-flex align-items-center mb-3">
                <div class="dashboard-icon me-3">
                    <i class="bi bi-people-fill"></i>
                </div>
                <h5 class="mb-0">Manage Patients</h5>
            </div>

            <p class="text-muted">
                Add, edit, and manage patient records seamlessly.
            </p>

            <a href="@Url.Action("Patients", "Receptionist")"
               class="btn btn-primary mt-2">
                <i class="bi bi-arrow-right-circle me-1"></i>
                View Patients
            </a>
        </div>
    </div>

    <!-- Today's Appointments -->
    <div class="col-md-6">
        <div class="dashboard-card h-100">
            <div class="d-flex align-items-center mb-3">
                <div class="dashboard-icon me-3">
                    <i class="bi bi-calendar-check-fill"></i>
                </div>
                <h5 class="mb-0">Today's Appointments</h5>
            </div>

            <p class="text-muted">
                Review and manage scheduled appointments for today.
            </p>

            <a href="@Url.Action("TodayAppointments", "Receptionist")"
               class="btn btn-primary mt-2">
                <i class="bi bi-arrow-right-circle me-1"></i>
                View Appointments
            </a>
        </div>
    </div>

</div>