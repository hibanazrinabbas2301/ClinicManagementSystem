@model IEnumerable<ClinicManagementSystem.Models.Patient>

@{
    ViewData["Title"] = "Patients";
    var mmrNo = Context.Request.Query["mmrNo"].ToString();
    var phone = Context.Request.Query["phone"].ToString();
    var genderList = new List<string> { "Male", "Female", "Other" };
}

<div class="mb-3">
    <a href="@Url.Action("Index", "Receptionist")" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Dashboard
    </a>
</div>

<h2 class="mb-4 text-center">Patients List</h2>

@if (TempData["PatientUpdateSuccess"] != null)
{
    <div class="alert alert-success text-center">
        @TempData["PatientUpdateSuccess"]
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <!-- Search form -->
    <form method="get" asp-action="Patients" asp-controller="Receptionist" class="d-flex gap-2 flex-wrap">
        <input type="text" name="mmrNo" class="form-control" placeholder="Search by MMR No" value="@mmrNo" />
        <input type="text" name="phone" class="form-control" placeholder="Search by Phone" value="@phone" />
        <button type="submit" class="btn btn-primary">Search</button>
    </form>

    <!-- Add Patient Button -->
    <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#addPatientModal">
        <i class="bi bi-person-plus"></i> Add New Patient
    </button>
</div>

<!-- ===================== ADD PATIENT MODAL ===================== -->
<div class="modal fade" id="addPatientModal" tabindex="-1" aria-labelledby="addPatientModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="addPatientForm" asp-action="AddPatient" asp-controller="Receptionist" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="addPatientModalLabel">Add New Patient</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">MMR No</label>
                        <input type="text" name="MMRNo" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input type="text" name="PatientName" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Gender</label>
                        @Html.DropDownList("Gender", new SelectList(genderList), "-- Select Gender --",
                        new { @class = "form-select", required = "required" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Date of Birth</label>
                        <input type="date" name="DOB" class="form-control" required min="1950-01-01"
                               max="@DateTime.Now.ToString("yyyy-MM-dd")" />
                    </div>

                    <!-- Phone Validation -->
                    <div class="mb-3">
                        <label class="form-label">Phone</label>
                        <input type="text" id="ContactNumber" name="ContactNumber"
                               class="form-control"
                               required minlength="10" maxlength="10"
                               pattern="[0-9]{10}"
                               title="Enter a valid 10-digit phone number" />
                        <small id="phoneError" class="text-danger"></small>
                    </div>

                    <!-- Blood Group Validation -->
                    <div class="mb-3">
                        <label class="form-label">Blood Group</label>
                        <input type="text" id="BloodGroup" name="BloodGroup"
                               class="form-control"
                               required
                               title="Enter a valid blood group (A+, A-, B+, B-, AB+, AB-, O+, O-)" />
                        <small id="bloodError" class="text-danger"></small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Address</label>
                        <textarea name="Address" class="form-control" rows="2" maxlength="200"></textarea>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Add Patient</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Add Patient Validation Script -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const form = document.getElementById("addPatientForm");
        const phoneInput = document.getElementById("ContactNumber");
        const bloodInput = document.getElementById("BloodGroup");
        const phoneError = document.getElementById("phoneError");
        const bloodError = document.getElementById("bloodError");

        form.addEventListener("submit", function (event) {
            const phone = phoneInput.value.trim();
            const blood = bloodInput.value.trim().toUpperCase();
            bloodInput.value = blood;

            const phonePattern = /^[0-9]{10}$/;
            const sequential = "1234567890";
            const bloodPattern = /^(A|B|AB|O)[+-]$/i;

            let isValid = true;

            // Phone validation
            if (!phonePattern.test(phone)) {
                phoneError.textContent = "Phone number must contain exactly 10 digits.";
                isValid = false;
            } else if (/^(\d)\1{9}$/.test(phone)) {
                phoneError.textContent = "Phone number cannot be all same digits.";
                isValid = false;
            } else if (phone === sequential) {
                phoneError.textContent = "Sequential numbers like 1234567890 are not allowed.";
                isValid = false;
            } else if (phone.startsWith("0")) {
                phoneError.textContent = "Phone number cannot start with 0.";
                isValid = false;
            } else {
                phoneError.textContent = "";
            }

            // Blood group validation
            if (!bloodPattern.test(blood)) {
                bloodError.textContent = "Enter valid blood group (A+, A-, B+, B-, AB+, AB-, O+, O-)";
                isValid = false;
            } else {
                bloodError.textContent = "";
            }

            if (!isValid) event.preventDefault();
        });
    });
</script>

<!-- ===================== PATIENTS TABLE ===================== -->
<table class="table table-bordered table-striped">
    <thead class="table-light text-center">
        <tr>
            <th>MMR No</th>
            <th>Name</th>
            <th>Gender</th>
            <th>DOB</th>
            <th>Phone</th>
            <th>Address</th>
            <th>Blood Group</th>
            <th style="width: 260px;">Actions</th>
        </tr>
    </thead>

    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var patient in Model)
            {
                <tr>
                    <td>@patient.MMRNo</td>
                    <td>@patient.PatientName</td>
                    <td>@patient.Gender</td>
                    <td>@(patient.DOB != DateTime.MinValue ? patient.DOB.ToString("dd/MM/yyyy") : "")</td>
                    <td>@patient.ContactNumber</td>
                    <td>@patient.Address</td>
                    <td>@patient.BloodGroup</td>

                    <!-- ✅ ONLY ONE actions cell (Create Appointment + Edit) -->
                    <td class="text-center">

                        <!-- Create Appointment -->
                        <a class="btn btn-sm btn-primary mb-1"
                           asp-action="TodayAppointments"
                           asp-controller="Receptionist"
                           asp-route-patientId="@patient.PatientId"
                           asp-route-slotDate="@DateTime.Today.ToString("yyyy-MM-dd")">
                            <i class="bi bi-calendar-plus"></i> Create Appointment
                        </a>

                        <!-- ✅ Edit (ONLY Phone + Address editable) -->
                        <button type="button"
                                class="btn btn-sm btn-warning mb-1"
                                data-bs-toggle="modal"
                                data-bs-target="#editPatientModal_@patient.PatientId">
                            <i class="bi bi-pencil-square"></i> Edit
                        </button>

                        <!-- ===================== EDIT MODAL ===================== -->
                        <div class="modal fade"
                             id="editPatientModal_@patient.PatientId"
                             tabindex="-1"
                             aria-labelledby="editPatientModalLabel_@patient.PatientId"
                             aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">

                                    <!-- ✅ IMPORTANT:
                                         This action should update ONLY phone + address in controller.
                                         If your action name is different, change asp-action. -->
                                    <form id="editPatientForm_@patient.PatientId"
                                          asp-action="EditPatientContact"
                                          asp-controller="Receptionist"
                                          method="post">
                                        @Html.AntiForgeryToken()

                                        <input type="hidden" name="patientId" value="@patient.PatientId" />

                                        <div class="modal-header">
                                            <h5 class="modal-title" id="editPatientModalLabel_@patient.PatientId">
                                                Edit Contact Details
                                            </h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>

                                        <div class="modal-body">

                                            <div asp-validation-summary="All" class="text-danger mb-2"></div>

                                            <!-- READONLY FIELDS -->
                                            <div class="mb-3">
                                                <label class="form-label">MMR No</label>
                                                <input type="text" class="form-control" value="@patient.MMRNo" readonly />
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label">Name</label>
                                                <input type="text" class="form-control" value="@patient.PatientName" readonly />
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label">Gender</label>
                                                <input type="text" class="form-control" value="@patient.Gender" readonly />
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label">Date of Birth</label>
                                                <input type="text" class="form-control"
                                                       value="@(patient.DOB != DateTime.MinValue ? patient.DOB.ToString("dd/MM/yyyy") : "")"
                                                       readonly />
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label">Blood Group</label>
                                                <input type="text" class="form-control" value="@patient.BloodGroup" readonly />
                                            </div>

                                            <!-- ✅ EDITABLE: Phone -->
                                            <div class="mb-3">
                                                <label class="form-label">Phone</label>
                                                <input type="text"
                                                       id="ContactNumber_@patient.PatientId"
                                                       name="phone"
                                                       class="form-control"
                                                       required minlength="10" maxlength="10"
                                                       pattern="[0-9]{10}"
                                                       value="@patient.ContactNumber"
                                                       title="Enter a valid 10-digit phone number" />
                                                <small id="phoneError_@patient.PatientId" class="text-danger"></small>
                                            </div>

                                            <!-- ✅ EDITABLE: Address -->
                                            <div class="mb-3">
                                                <label class="form-label">Address</label>
                                                <textarea name="address"
                                                  class="form-control"
                                                  rows="2"
                                                  maxlength="200"
                                                  required>@patient.Address</textarea>
                                            </div>

                                        </div>

                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                            <button type="submit" class="btn btn-primary">Update</button>
                                        </div>
                                    </form>

                                </div>
                            </div>
                        </div>

                        <!-- Phone validation script for edit modal -->
                        <script>
                            document.addEventListener("DOMContentLoaded", function () {
                                const form = document.getElementById("editPatientForm_@patient.PatientId");
                                const phoneInput = document.getElementById("ContactNumber_@patient.PatientId");
                                const phoneError = document.getElementById("phoneError_@patient.PatientId");

                                if (!form || !phoneInput) return;

                                form.addEventListener("submit", function (event) {
                                    const phone = phoneInput.value.trim();

                                    const phonePattern = /^[0-9]{10}$/;
                                    const sequential = "1234567890";
                                    let isValid = true;

                                    if (!phonePattern.test(phone)) {
                                        phoneError.textContent = "Phone number must contain exactly 10 digits.";
                                        isValid = false;
                                    } else if (/^(\d)\1{9}$/.test(phone)) {
                                        phoneError.textContent = "Phone number cannot be all same digits.";
                                        isValid = false;
                                    } else if (phone === sequential) {
                                        phoneError.textContent = "Sequential numbers like 1234567890 are not allowed.";
                                        isValid = false;
                                    } else if (phone.startsWith("0")) {
                                        phoneError.textContent = "Phone number cannot start with 0.";
                                        isValid = false;
                                    } else {
                                        phoneError.textContent = "";
                                    }

                                    if (!isValid) event.preventDefault();
                                });
                            });
                        </script>

                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="8" class="text-center text-muted">No patients found.</td>
            </tr>
        }
    </tbody>
</table>