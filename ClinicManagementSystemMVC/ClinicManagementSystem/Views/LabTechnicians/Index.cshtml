@model IEnumerable<ClinicManagementSystem.Models.LabTest>

@{
    ViewData["Title"] = "Lab Technician Panel";
    var pendingTests = ViewBag.PendingTests as IEnumerable<ClinicManagementSystem.Models.LabTestPrescription>;
    var completedTests = ViewBag.CompletedTests as IEnumerable<ClinicManagementSystem.Models.LabTestPrescription>;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />

<div class="container-fluid mt-4">

    <h2 class="fw-bold text-primary mb-4">
        <i class="fas fa-flask"></i> Lab Technician Control Panel
    </h2>

    <!-- ================= DASHBOARD CARDS ================= -->
    <div class="row mb-4">

        <div class="col-md-3">
            <div class="card dashboard-card bg-primary text-white"
                 onclick="showSection('availableSection')">
                <div class="card-body">
                    <h6>Total Tests</h6>
                    <h2>@Model.Count()</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card dashboard-card bg-warning text-dark"
                 onclick="showSection('pendingSection')">
                <div class="card-body">
                    <h6>Pending</h6>
                    <h2>@(pendingTests?.Count(t => t.Status != "Completed") ?? 0)</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card dashboard-card bg-success text-white"
                 onclick="showSection('completedSection')">
                <div class="card-body">
                    <h6>Completed</h6>
                    <h2>@(completedTests?.Count() ?? 0)</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card dashboard-card bg-dark text-white"
                 onclick="showSection('resultSection')">
                <div class="card-body">
                    <h6>Lab Results</h6>
                    <h2><i class="fas fa-file-medical"></i></h2>
                </div>
            </div>
        </div>

    </div>

    <!-- ================= AVAILABLE TESTS ================= -->
    <div id="availableSection" class="section-block">

        <div class="card shadow-lg">
            <div class="card-header bg-dark text-white">
                Available Lab Tests
            </div>

            <div class="card-body">

                <input type="text" id="searchAvailable"
                       class="form-control mb-3"
                       placeholder="🔍 Search Available Tests">

                <table class="table table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Name</th>
                            <th>Price</th>
                            <th>Sample</th>
                            <th>Range</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var test in Model)
                        {
                            <tr>
                                <td>@test.TestName</td>
                                <td>₹ @test.Price</td>
                                <td>@test.SampleType</td>
                                <td>@test.NormalRange</td>
                            </tr>
                        }
                    </tbody>
                </table>

            </div>
        </div>

    </div>

    <!-- ================= PENDING ================= -->
    <div id="pendingSection" class="section-block d-none">

        <div class="card shadow-lg">
            <div class="card-header bg-warning">
                Pending Tests
            </div>

            <div class="card-body">

                <input type="text" id="searchPending"
                       class="form-control mb-3"
                       placeholder="🔍 Search Pending Tests">

                <div class="table-responsive">
                    <table class="table table-bordered">
                        <thead class="table-warning">
                            <tr>
                                <th>Patient</th>
                                <th>Doctor</th>
                                <th>Test</th>
                                <th>Price</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in pendingTests)
                            {
                                <tr>
                                    <td>@item.PatientName</td>
                                    <td>@item.DoctorName</td>
                                    <td>@item.TestName</td>
                                    <td>₹ @item.Price</td>
                                    <td>
                                        <button class="btn btn-success btn-sm addResultBtn"
                                                data-prescription="@item.PrescriptionId"
                                                data-test="@item.TestId"
                                                data-patient="@item.PatientId"
                                                data-normal="@item.NormalRange"
                                                data-price="@item.Price">
                                            Add Result
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>

        </div>

    </div>

    <!-- ================= COMPLETED ================= -->
    <div id="completedSection" class="section-block d-none">

        <div class="card shadow-lg">
            <div class="card-header bg-success text-white">
                Completed Tests
            </div>

            <div class="card-body">

                <input type="text" id="searchCompleted"
                       class="form-control mb-3"
                       placeholder="🔍 Search Completed Tests">

                <div class="table-responsive">
                    <table class="table table-bordered">
                        <thead class="table-success">
                            <tr>
                                <th>Patient</th>
                                <th>Doctor</th>
                                <th>Test</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in completedTests)
                            {
                                <tr>
                                    <td>@item.PatientName</td>
                                    <td>@item.DoctorName</td>
                                    <td>@item.TestName</td>
                                    <td>
                                        <span class="badge bg-success">
                                            @item.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>

        </div>

    </div>

</div>

<!-- ================= ADD RESULT MODAL ================= -->
<div class="modal fade"
     id="addResultModal"
     data-bs-backdrop="static"
     data-bs-keyboard="false">

    <div class="modal-dialog">
        <div class="modal-content">

            <form id="resultForm">
                @Html.AntiForgeryToken()

                <div class="modal-header bg-success text-white">
                    <h5>Add Lab Result</h5>
                    <button type="button" class="btn-close btn-close-white"
                            data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">

                    <input type="hidden" id="rTestId" name="TestId" />
                    <input type="hidden" id="rPatientId" name="PatientId" />
                    <input type="hidden" id="rPrescriptionId" />

                    <div class="mb-2">
                        <label>Normal Range</label>
                        <input id="rNormalRange" name="NormalRange"
                               class="form-control" readonly />
                    </div>

                    <div class="mb-2">
                        <label>Actual Value</label>
                        <input name="ActualValue"
                               type="number"
                               step="0.01"
                               class="form-control"
                               required />
                    </div>

                    <div class="mb-2">
                        <label>Remarks</label>
                        <textarea name="Remarks"
                                  class="form-control"></textarea>
                    </div>

                    <div class="mb-2">
                        <label>Bill Amount (₹)</label>
                        <input id="rBill" class="form-control" readonly />
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="submit"
                            class="btn btn-success">
                        Save & Generate Report
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<script>

    function showSection(sectionId) {
        $('.section-block').addClass('d-none');
        $('#' + sectionId).removeClass('d-none');
    }

    $(document).ready(function () {
        showSection('availableSection');
    });

    // Live Search
    $("#searchAvailable").on("keyup", function () {
        var value = $(this).val().toLowerCase();
        $("#availableSection tbody tr").filter(function () {
            $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
        });
    });

    $("#searchPending").on("keyup", function () {
        var value = $(this).val().toLowerCase();
        $("#pendingSection tbody tr").filter(function () {
            $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
        });
    });

    $("#searchCompleted").on("keyup", function () {
        var value = $(this).val().toLowerCase();
        $("#completedSection tbody tr").filter(function () {
            $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
        });
    });

    // Open Add Result Modal
    $('.addResultBtn').click(function () {

        $('#rPrescriptionId').val($(this).data('prescription'));
        $('#rTestId').val($(this).data('test'));
        $('#rPatientId').val($(this).data('patient'));
        $('#rNormalRange').val($(this).data('normal'));
        $('#rBill').val($(this).data('price'));

        new bootstrap.Modal(document.getElementById('addResultModal')).show();
    });

    // Save Result + Generate PDF
    $('#resultForm').submit(function (e) {
        e.preventDefault();

        let data = $(this).serialize() +
            "&PrescriptionId=" + $('#rPrescriptionId').val();

        $.post('/LabTechnicians/AddLabResult',
            data,
            function (res) {

                if (res.success) {

                    window.open('/LabTechnicians/PrintLabBill?resultId='
                        + res.resultId, '_blank');

                    showSection('completedSection');

                    location.reload();
                }
            });
    });

</script>

