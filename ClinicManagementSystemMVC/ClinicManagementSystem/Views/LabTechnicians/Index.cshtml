@model IEnumerable<ClinicManagementSystem.Models.LabTest>

@{
    ViewData["Title"] = "Lab Technician Dashboard";
    var pendingTests = ViewBag.PendingTests as IEnumerable<ClinicManagementSystem.Models.LabTestPrescription>;
}

<!-- Include Font Awesome for icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

<div class="container-fluid mt-4">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary">
            <i class="fas fa-flask"></i> Lab Technician Dashboard
        </h2>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createLabTestModal">
            <i class="fas fa-plus-circle"></i> Add New Lab Test
        </button>
    </div>

    <!-- Summary Cards with View Buttons -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card text-white" style="background-color: grey;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h5 class="card-title"><i class="fas fa-vial"></i> Total Lab Tests</h5>
                            <h2 class="card-text mb-3">@Model.Count()</h2>
                            <button class="btn btn-light btn-sm view-tests-btn" data-target="availableTests">
                                <i class="fas fa-eye"></i> View Tests
                            </button>
                        </div>
                        <i class="fas fa-flask fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white" style="background-color: grey;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h5 class="card-title"><i class="fas fa-clock"></i> Pending Tests</h5>
                            <h2 class="card-text mb-3">@(pendingTests?.Count(t => t.Status != "Completed") ?? 0)</h2>
                            <button class="btn btn-light btn-sm view-tests-btn" data-target="pendingTests">
                                <i class="fas fa-eye"></i> View Pending
                            </button>
                        </div>
                        <i class="fas fa-hourglass-half fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white" style="background-color: grey;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h5 class="card-title"><i class="fas fa-check-circle"></i> Completed Today</h5>
                            <h2 class="card-text mb-3">
                                @(pendingTests?.Count(t => t.Status == "Completed" && t.PrescribedDate.Date == DateTime.Today) ?? 0)
                            </h2>
                            <button class="btn btn-light btn-sm view-tests-btn" data-target="completedTests">
                                <i class="fas fa-eye"></i> View Completed
                            </button>
                        </div>
                        <i class="fas fa-calendar-check fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Sections Container (Initially Hidden) -->
    <div id="sectionsContainer" style="display: none;">
        <!-- Pending Lab Tests Section -->
        <div id="pendingTests" class="card shadow mb-4 section-card">
            <div class="card-header bg-warning text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="fas fa-clock"></i> Pending Lab Tests</h5>
                <button class="btn btn-light btn-sm close-section">
                    <i class="fas fa-times"></i> Close
                </button>
            </div>
            <div class="card-body">
                @if (pendingTests != null && pendingTests.Any(t => t.Status != "Completed"))
                {
                    <div class="table-responsive">
                        <table class="table table-hover table-striped">
                            <thead class="table-dark">
                                <tr>
                                    <th>Prescription #</th>
                                    <th>Patient ID</th>
                                    <th>Test Name</th>
                                    <th>Quantity</th>
                                    <th>Prescribed Date</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var test in pendingTests.Where(t => t.Status != "Completed"))
                                {
                                    <tr>
                                        <td><span class="badge bg-secondary">PR-@test.PrescriptionId</span></td>
                                        <td>@test.PatientId</td>
                                        <td>@test.TestName</td>
                                        <td>@test.Quantity</td>
                                        <td>@test.PrescribedDate.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            @if (test.Status == "Pending")
                                            {
                                                <span class="badge bg-warning text-dark">Pending</span>
                                            }
                                        </td>
                                        <td>
                                            <button class="btn btn-sm btn-success addResultBtn"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#addResultModal"
                                                    data-prescriptionid="@test.PrescriptionId"
                                                    data-testid="@test.TestId"
                                                    data-patientid="@test.PatientId"
                                                    data-testname="@test.TestName"
                                                    data-quantity="@test.Quantity"
                                                    title="Add Test Result">
                                                <i class="fas fa-plus-circle"></i> Add Result
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-success mb-0">
                        <i class="fas fa-check-circle"></i> No pending lab tests. All tests are completed!
                    </div>
                }
            </div>
        </div>

        <!-- Completed Tests Section -->
        @if (pendingTests != null && pendingTests.Any(t => t.Status == "Completed"))
        {
            <div id="completedTests" class="card shadow mb-4 section-card">
                <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="fas fa-check-circle"></i> Completed Tests</h5>
                    <button class="btn btn-light btn-sm close-section">
                        <i class="fas fa-times"></i> Close
                    </button>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover table-striped">
                            <thead class="table-dark">
                                <tr>
                                    <th>Prescription #</th>
                                    <th>Patient ID</th>
                                    <th>Test Name</th>
                                    <th>Quantity</th>
                                    <th>Completed Date</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var test in pendingTests.Where(t => t.Status == "Completed"))
                                {
                                    <tr>
                                        <td><span class="badge bg-secondary">PR-@test.PrescriptionId</span></td>
                                        <td>@test.PatientId</td>
                                        <td>@test.TestName</td>
                                        <td>@test.Quantity</td>
                                        <td>@test.PrescribedDate.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            <button class="btn btn-sm btn-primary generateBillBtn"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#generateBillModal"
                                                    data-resultid="@test.PrescriptionId"
                                                    data-testname="@test.TestName"
                                                    data-quantity="@test.Quantity"
                                                    title="Generate Bill">
                                                <i class="fas fa-file-invoice"></i> Generate Bill
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        <!-- Available Lab Tests Section -->
        <div id="availableTests" class="card shadow mb-4 section-card">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="fas fa-vial"></i> Available Lab Tests</h5>
                <button class="btn btn-light btn-sm close-section">
                    <i class="fas fa-times"></i> Close
                </button>
            </div>
            <div class="card-body">
                @if (Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover table-striped">
                            <thead class="table-dark">
                                <tr>
                                    <th>Test ID</th>
                                    <th>Test Name</th>
                                    <th>Sample Type</th>
                                    <th>Normal Range</th>
                                    <th>Price (₹)</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td><span class="badge bg-secondary">@item.TestId</span></td>
                                        <td>@item.TestName</td>
                                        <td>@item.SampleType</td>
                                        <td>@item.NormalRange</td>
                                        <td>₹ @item.Price.ToString("F2")</td>
                                        <td>
                                            <button class="btn btn-sm btn-warning editLabTestBtn"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#editLabTestModal"
                                                    data-id="@item.TestId"
                                                    data-testname="@item.TestName"
                                                    data-price="@item.Price"
                                                    data-sampletype="@item.SampleType"
                                                    data-normalrange="@item.NormalRange"
                                                    title="Edit Test">
                                                <i class="fas fa-edit"></i> Edit
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info mb-0">
                        <i class="fas fa-info-circle"></i> No lab tests available. Click "Add New Lab Test" to create one.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- All modals remain exactly the same - keeping them unchanged -->
<!-- Create Lab Test Modal -->
<div class="modal fade" id="createLabTestModal" tabindex="-1" aria-labelledby="createLabTestModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="createLabTestModalLabel">
                    <i class="fas fa-plus-circle"></i> Add New Lab Test
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="createLabTestForm" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="TestName" class="form-label">Test Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="TestName" name="TestName" required maxlength="100">
                            <span class="text-danger" id="TestName-error"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="Price" class="form-label">Price (₹) <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="Price" name="Price" step="0.01" min="1" required>
                            <span class="text-danger" id="Price-error"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="SampleType" class="form-label">Sample Type <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="SampleType" name="SampleType" required maxlength="50">
                            <span class="text-danger" id="SampleType-error"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="NormalRange" class="form-label">Normal Range</label>
                            <input type="text" class="form-control" id="NormalRange" name="NormalRange" maxlength="100">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="btnSaveLabTest">
                        <i class="fas fa-save"></i> Save Test
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Lab Test Modal -->
<div class="modal fade" id="editLabTestModal" tabindex="-1" aria-labelledby="editLabTestModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title" id="editLabTestModalLabel">
                    <i class="fas fa-edit"></i> Edit Lab Test
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="editLabTestForm" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editTestId" name="TestId">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="editTestName" class="form-label">Test Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="editTestName" name="TestName" required maxlength="100">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="editPrice" class="form-label">Price (₹) <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="editPrice" name="Price" step="0.01" min="1" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="editSampleType" class="form-label">Sample Type <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="editSampleType" name="SampleType" required maxlength="50">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="editNormalRange" class="form-label">Normal Range</label>
                            <input type="text" class="form-control" id="editNormalRange" name="NormalRange" maxlength="100">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning" id="btnUpdateLabTest">
                        <i class="fas fa-save"></i> Update Test
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Add Result Modal -->
<div class="modal fade" id="addResultModal" tabindex="-1" aria-labelledby="addResultModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="addResultModalLabel">
                    <i class="fas fa-flask"></i> Add Lab Test Result
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="addResultForm" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="PrescriptionId" name="PrescriptionId">
                <input type="hidden" id="TestId" name="TestId">
                <input type="hidden" id="PatientId" name="PatientId">

                <div class="modal-body">
                    <div class="alert alert-info" id="testInfoAlert">
                        <strong>Test:</strong> <span id="displayTestName"></span> |
                        <strong>Quantity:</strong> <span id="displayQuantity"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label for="LowRange" class="form-label">Low Range <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="LowRange" name="LowRange" step="0.01" required>
                            <span class="text-danger" id="LowRange-error"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="HighRange" class="form-label">High Range <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="HighRange" name="HighRange" step="0.01" required>
                            <span class="text-danger" id="HighRange-error"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="ActualValue" class="form-label">Actual Value <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="ActualValue" name="ActualValue" step="0.01" required>
                            <span class="text-danger" id="ActualValue-error"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="Remarks" class="form-label">Remarks</label>
                        <textarea class="form-control" id="Remarks" name="Remarks" rows="2" maxlength="255"></textarea>
                    </div>

                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="markCompleted" checked>
                            <label class="form-check-label" for="markCompleted">
                                Mark test as completed after saving result
                            </label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success" id="btnSaveResult">
                        <i class="fas fa-save"></i> Save Result
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Generate Bill Modal -->
<div class="modal fade" id="generateBillModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    <i class="fas fa-file-invoice"></i> Generate Lab Bill
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="generateBillForm" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="billResultId" name="resultId">
                <div class="modal-body">
                    <div class="alert alert-info">
                        <strong>Test:</strong> <span id="billTestName"></span><br>
                        <strong>Quantity:</strong> <span id="billQuantity"></span><br>
                        <strong>Amount:</strong> ₹ <span id="billAmount"></span>
                    </div>
                    <input type="hidden" id="billAmountInput" name="amount">
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="confirmGenerateBill">
                        <i class="fas fa-check"></i> Generate Bill
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Toast Notification Container -->
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 9999;"></div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        $(document).ready(function () {
            // View Tests button click handler
            $('.view-tests-btn').click(function () {
                var targetId = $(this).data('target');

                // Hide all sections first
                $('.section-card').hide();

                // Show the container if hidden
                $('#sectionsContainer').show();

                // Show the specific section
                $('#' + targetId).show();

                // Smooth scroll to the section
                $('html, body').animate({
                    scrollTop: $('#' + targetId).offset().top - 20
                }, 500);
            });

            // Close section button click handler
            $('.close-section').click(function () {
                // Hide the current section
                $(this).closest('.section-card').hide();

                // If all sections are hidden, hide the container
                if ($('.section-card:visible').length === 0) {
                    $('#sectionsContainer').hide();
                }
            });

            // ================= CREATE LAB TEST =================
            $('#createLabTestForm').submit(function (e) {
                e.preventDefault();

                // Clear previous errors
                $('.text-danger').empty();

                var formData = {
                    TestName: $('#TestName').val(),
                    Price: $('#Price').val(),
                    SampleType: $('#SampleType').val(),
                    NormalRange: $('#NormalRange').val()
                };

                var token = $('input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    type: "POST",
                    url: '@Url.Action("Create", "LabTechnicians")',
                    data: formData,
                    headers: { "RequestVerificationToken": token },
                    success: function (response) {
                        if (response.success) {
                            $('#createLabTestModal').modal('hide');
                            showNotification('Lab Test Added Successfully!', 'success');
                            setTimeout(function () { location.reload(); }, 1500);
                        } else {
                            if (response.errors) {
                                displayErrors(response.errors);
                            } else {
                                showNotification('Error: ' + response.message, 'error');
                            }
                        }
                    },
                    error: function (xhr) {
                        if (xhr.status === 400) {
                            var errors = xhr.responseJSON.errors;
                            displayErrors(errors);
                        } else {
                            showNotification('An error occurred while saving.', 'error');
                        }
                    }
                });
            });

            // ================= EDIT LAB TEST =================
            $('.editLabTestBtn').click(function () {
                $('#editTestId').val($(this).data('id'));
                $('#editTestName').val($(this).data('testname'));
                $('#editPrice').val($(this).data('price'));
                $('#editSampleType').val($(this).data('sampletype'));
                $('#editNormalRange').val($(this).data('normalrange'));
            });

            $('#editLabTestForm').submit(function (e) {
                e.preventDefault();

                var formData = {
                    TestId: $('#editTestId').val(),
                    TestName: $('#editTestName').val(),
                    Price: $('#editPrice').val(),
                    SampleType: $('#editSampleType').val(),
                    NormalRange: $('#editNormalRange').val()
                };

                var token = $('input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    type: "POST",
                    url: '@Url.Action("Edit", "LabTechnicians")',
                    data: formData,
                    headers: { "RequestVerificationToken": token },
                    success: function (response) {
                        if (response.success) {
                            $('#editLabTestModal').modal('hide');
                            showNotification('Lab Test Updated Successfully!', 'success');
                            setTimeout(function () { location.reload(); }, 1500);
                        } else {
                            showNotification('Error: ' + response.message, 'error');
                        }
                    },
                    error: function () {
                        showNotification('An error occurred while updating.', 'error');
                    }
                });
            });

            // ================= ADD RESULT =================
            $('.addResultBtn').click(function () {
                $('#PrescriptionId').val($(this).data('prescriptionid'));
                $('#TestId').val($(this).data('testid'));
                $('#PatientId').val($(this).data('patientid'));
                $('#displayTestName').text($(this).data('testname'));
                $('#displayQuantity').text($(this).data('quantity'));

                // Clear previous values
                $('#LowRange, #HighRange, #ActualValue, #Remarks').val('');
                $('.text-danger').empty();
            });

            $('#addResultForm').submit(function (e) {
                e.preventDefault();

                // Clear previous errors
                $('.text-danger').empty();

                // Validate ranges
                var lowRange = parseFloat($('#LowRange').val());
                var highRange = parseFloat($('#HighRange').val());
                var actualValue = parseFloat($('#ActualValue').val());

                if (lowRange >= highRange) {
                    showNotification('Low Range must be less than High Range!', 'warning');
                    return;
                }

                if (actualValue < lowRange || actualValue > highRange) {
                    showNotification('Actual Value is outside the normal range!', 'warning');
                }

                var formData = {
                    PrescriptionId: $('#PrescriptionId').val(),
                    TestId: $('#TestId').val(),
                    PatientId: $('#PatientId').val(),
                    LowRange: lowRange,
                    HighRange: highRange,
                    ActualValue: actualValue,
                    Remarks: $('#Remarks').val()
                };

                var token = $('input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    type: "POST",
                    url: '@Url.Action("AddLabResult", "LabTechnicians")',
                    data: formData,
                    headers: { "RequestVerificationToken": token },
                    success: function (response) {
                        if (response.success) {
                            // If checkbox is checked, mark test as completed
                            if ($('#markCompleted').is(':checked')) {
                                var prescriptionId = $('#PrescriptionId').val();
                                $.ajax({
                                    type: "POST",
                                    url: '@Url.Action("UpdateTestStatus", "LabTechnicians")',
                                    data: { prescriptionId: prescriptionId, status: "Completed" },
                                    headers: { "RequestVerificationToken": token },
                                    success: function () {
                                        $('#addResultModal').modal('hide');
                                        showNotification('Result Added and Test Marked as Completed!', 'success');
                                        setTimeout(function () { location.reload(); }, 1500);
                                    }
                                });
                            } else {
                                $('#addResultModal').modal('hide');
                                showNotification('Result Added Successfully!', 'success');
                                setTimeout(function () { location.reload(); }, 1500);
                            }
                        } else {
                            if (response.errors) {
                                displayErrors(response.errors);
                            } else {
                                showNotification('Error: ' + response.message, 'error');
                            }
                        }
                    },
                    error: function (xhr) {
                        if (xhr.status === 400) {
                            var errors = xhr.responseJSON.errors;
                            displayErrors(errors);
                        } else {
                            showNotification('An error occurred while saving result.', 'error');
                        }
                    }
                });
            });

            // ================= GENERATE BILL =================
            $('.generateBillBtn').click(function () {
                var resultId = $(this).data('resultid');
                var testName = $(this).data('testname');
                var quantity = $(this).data('quantity');

                // Get price from the test (you might need to adjust this based on your data)
                var price = 100; // Default price, you should get this from your data

                var amount = price * quantity;

                $('#billResultId').val(resultId);
                $('#billTestName').text(testName);
                $('#billQuantity').text(quantity);
                $('#billAmount').text(amount.toFixed(2));
                $('#billAmountInput').val(amount);
            });

            $('#generateBillForm').submit(function (e) {
                e.preventDefault();

                var resultId = $('#billResultId').val();
                var amount = $('#billAmountInput').val();
                var token = $('input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    type: "POST",
                    url: '@Url.Action("GenerateLabBill", "LabTechnicians")',
                    data: { resultId: resultId, amount: amount },
                    headers: { "RequestVerificationToken": token },
                    success: function (response) {
                        if (response.success) {
                            $('#generateBillModal').modal('hide');
                            showNotification('Lab Bill Generated Successfully!', 'success');
                            setTimeout(function () { location.reload(); }, 1500);
                        } else {
                            showNotification('Error: ' + response.message, 'error');
                        }
                    },
                    error: function () {
                        showNotification('An error occurred while generating bill.', 'error');
                    }
                });
            });

            // ================= HELPER FUNCTIONS =================
            function displayErrors(errors) {
                if (typeof errors === 'object') {
                    $.each(errors, function (field, messages) {
                        var errorSpan = $('#' + field + '-error');
                        if (errorSpan.length) {
                            errorSpan.text(messages.join(', '));
                        }
                    });
                } else if (Array.isArray(errors)) {
                    showNotification(errors.join(', '), 'error');
                }
            }

            function showNotification(message, type) {
                var bgClass = type === 'success' ? 'bg-success' :
                             type === 'warning' ? 'bg-warning' : 'bg-danger';
                var iconClass = type === 'success' ? 'fa-check-circle' :
                               type === 'warning' ? 'fa-exclamation-triangle' : 'fa-times-circle';

                var toast = $(`
                    <div class="toast align-items-center text-white ${bgClass} border-0" role="alert" aria-live="assertive" aria-atomic="true">
                        <div class="d-flex">
                            <div class="toast-body">
                                <i class="fas ${iconClass} me-2"></i>
                                ${message}
                            </div>
                            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                        </div>
                    </div>
                `);

                $('.toast-container').append(toast);
                var bsToast = new bootstrap.Toast(toast);
                bsToast.show();

                setTimeout(function () {
                    toast.remove();
                }, 3000);
            }
        });
    </script>
}

