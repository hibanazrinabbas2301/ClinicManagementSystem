@model List<ClinicManagementSystem.Models.LabTest>

@{
    ViewData["Title"] = "Lab Technician Panel";
    var pending = ViewBag.PendingTests as List<ClinicManagementSystem.Models.LabTestPrescription>;
    var completed = ViewBag.CompletedTests as List<ClinicManagementSystem.Models.LabTestPrescription>;
}


<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="container-fluid py-4">

    <!-- HEADER -->
    <div class="page-header mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

            <div>
                <h2 class="fw-bold mb-1">Lab Technician Dashboard</h2>
                <p class="text-muted mb-0">
                    Manage lab tests and generate reports
                </p>
            </div>

            @* <a asp-controller="LabTechnicians"
               asp-action="Index"
               class="btn btn-primary">
                <i class="bi bi-arrow-left"></i> Back to Dashboard
            </a> *@

        </div>
    </div>

    <!-- DASHBOARD CARDS -->
    <div class="row mb-4 text-center">

        <div class="col-md-6">
            <div class="dashboard-card h-100"
                 onclick="showSection('pendingSection')">

                <h6 class="text-muted">Pending Tests</h6>
                <h2 class="fw-bold text-primary">
                    @(pending?.Count ?? 0)
                </h2>
            </div>
        </div>

        <div class="col-md-6">
            <div class="dashboard-card h-100"
                 onclick="showSection('completedSection')">

                <h6 class="text-muted">Completed Tests</h6>
                <h2 class="fw-bold text-primary">
                    @(completed?.Count ?? 0)
                </h2>
            </div>
        </div>

    </div>

    <!-- ================== PENDING SECTION ================== -->
    <div id="pendingSection" class="section-block">

        <h4 class="fw-bold mb-3 text-warning">
            Pending Lab Prescriptions
        </h4>

        <input type="text"
               id="searchPending"
               class="form-control mb-3 shadow-sm"
               placeholder="Search pending tests..." />

        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">
                <thead class="text-center">
                    <tr>
                        <th>Prescription No</th>
                        <th>Patient</th>
                        <th>Doctor</th>
                        <th>Test</th>
                        <th>Normal Range</th>
                        <th>Price (₹)</th>
                        <th width="150">Action</th>
                    </tr>
                </thead>

                <tbody>
                    @if (pending != null && pending.Count > 0)
                    {
                        foreach (var p in pending)
                        {
                            <tr>
                                <td class="fw-bold text-primary">
                                    Pr-@p.PrescriptionId
                                </td>

                                <td>@p.PatientName</td>
                                <td>@p.DoctorName</td>
                                <td>@p.TestName</td>
                                <td>@p.NormalRange</td>
                                <td class="fw-semibold">
                                    ₹ @p.Price
                                </td>

                                <td class="text-center">
                                    <button class="btn btn-primary btn-sm openResultModal"
                                            data-prescription="@p.PrescriptionId"
                                            data-test="@p.TestId"
                                            data-patient="@p.PatientId"
                                            data-price="@p.Price"
                                            data-range="@p.NormalRange">
                                        <i class="fas fa-plus-circle"></i> Add Result
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted">
                                No Pending Tests
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>


    <!-- ================== COMPLETED SECTION ================== -->
    <div id="completedSection" class="section-block d-none">

        <h4 class="fw-bold mb-3 text-success">
            Completed Lab Tests
        </h4>

        <input type="text"
               id="searchCompleted"
               class="form-control mb-3 shadow-sm"
               placeholder="Search completed tests..." />

        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">

                <thead class="text-center">
                    <tr>
                        <th>Prescription No</th>
                        <th>Patient</th>
                        <th>Doctor</th>
                        <th>Test</th>
                        <th>Actual Value</th>
                        <th>Remarks</th>
                        <th>Price (₹)</th>
                        <th>Result Date</th>
                        <th>Date</th>
                        <th width="140">Action</th>
                    </tr>
                </thead>

                <tbody>
                    @if (completed != null && completed.Count > 0)
                    {
                        foreach (var c in completed)
                        {
                            <tr>
                                <td class="fw-bold text-success">
                                    Pr-@c.PrescriptionId
                                </td>

                                <td>@c.PatientName</td>

                                <td>@c.DoctorName</td>

                                <td>@c.TestName</td>

                                <td class="fw-semibold">
                                    @c.ActualValue
                                </td>

                                <td>@c.Remarks</td>

                                <td class="fw-semibold">
                                    ₹ @c.Price
                                </td>

                                <td>
                                    @c.ResultDate?.ToString("dd/MM/yyyy")
                                </td>

                                <td>
                                    @c.PrescribedDate.ToString("dd/MM/yyyy")
                                </td>

                                <td class="text-center">
                                    <button class="btn btn-primary btn-sm"
                                            onclick="openPrintPreview(@c.ResultId)">
                                        <i class="fas fa-print"></i> Print
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="text-center text-muted">
                                No Completed Tests
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>

    </div>


</div>

<!-- ================== PRINT PREVIEW MODAL ================== -->
<div class="modal fade"
     id="printPreviewModal"
     data-bs-backdrop="static"
     data-bs-keyboard="false"
     tabindex="-1">

    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-body" id="printArea">

                <div class="text-center mb-4">
                    <h3 class="fw-bold">Wellness Clinic</h3>
                    <p class="text-muted">Official Lab Report</p>
                    <hr />
                </div>

                <table class="table table-bordered">
                    <tr>
                        <th>Prescription No</th>
                        <td id="pPrescription"></td>
                    </tr>
                    <tr>
                        <th>Patient</th>
                        <td id="pPatient"></td>
                    </tr>
                    <tr>
                        <th>Doctor</th>
                        <td id="pDoctor"></td>
                    </tr>
                    <tr>
                        <th>Test</th>
                        <td id="pTest"></td>
                    </tr>
                    <tr>
                        <th>Normal Range</th>
                        <td id="pRange"></td>
                    </tr>
                    <tr>
                        <th>Actual Value</th>
                        <td id="pActual"></td>
                    </tr>
                    <tr>
                        <th>Remarks</th>
                        <td id="pRemarks"></td>
                    </tr>
                    <tr>
                        <th>Price</th>
                        <td id="pPrice"></td>
                    </tr>
                    <tr>
                        <th>Result Date</th>
                        <td id="pResultDate"></td>
                    </tr>
                </table>

            </div>

            <div class="modal-footer">
                <button class="btn btn-primary"
                        onclick="printReportContent()">
                    <i class="fas fa-print"></i> Print
                </button>

                <button class="btn btn-danger"
                        data-bs-dismiss="modal">
                    Close
                </button>
            </div>

        </div>
    </div>
</div>


<!-- ================== RESULT MODAL ================== -->
<div class="modal fade" id="resultModal" data-bs-backdrop="static"
     data-bs-keyboard="false" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content shadow">
            <div class="modal-header">
                <h5>Add Lab Result</h5>
                <button type="button" class="btn-close"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <form id="resultForm">
                    @Html.AntiForgeryToken()

                    <input type="hidden" id="rPrescriptionId" />
                    <input type="hidden" id="rTestId" />
                    <input type="hidden" id="rPatientId" />
                    <input type="hidden" id="rEmail" />

                    <div class="mb-3">
                        <label>Normal Range</label>
                        <input type="text" id="rNormalRange"
                               class="form-control" readonly />
                    </div>

                    <div class="mb-3">
                        <label>Actual Value</label>
                        <input type="number" id="rActualValue"
                               class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label>Remarks</label>
                        <input type="text" id="rRemarks"
                               class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label>Bill Amount</label>
                        <input type="text" id="rBillAmount"
                               class="form-control" readonly />
                    </div>

                    <button type="submit"
                            class="btn btn-success w-100">
                        Save Result 
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>


<!--View Report-->
<div class="modal fade" id="viewReportModal"
     data-bs-backdrop="static"
     data-bs-keyboard="false"
     tabindex="-1">

    <div class="modal-dialog modal-lg">
        <div class="modal-content shadow-lg">

            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title">Lab Test Report</h5>
                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <div id="reportContent">

                    <table class="table table-bordered">
                        <tr>
                            <th>Patient Name</th>
                            <td id="vPatient"></td>
                        </tr>
                        <tr>
                            <th>Doctor Name</th>
                            <td id="vDoctor"></td>
                        </tr>
                        <tr>
                            <th>Test Name</th>
                            <td id="vTest"></td>
                        </tr>
                        <tr>
                            <th>Normal Range</th>
                            <td id="vRange"></td>
                        </tr>
                        <tr>
                            <th>Actual Value</th>
                            <td id="vActual"></td>
                        </tr>
                        <tr>
                            <th>Remarks</th>
                            <td id="vRemarks"></td>
                        </tr>
                        <tr>
                            <th>Date</th>
                            <td id="vDate"></td>
                        </tr>
                        <tr>
                            <th>Bill Amount</th>
                            <td id="vBill" class="fw-bold text-success"></td>
                        </tr>
                    </table>

                </div>

            </div>

        </div>
    </div>
</div>



@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>

        function openPrintPreview(resultId) {

            $.get('/LabTechnicians/GetLabReportDetails',
                { resultId: resultId },
                function (res) {

                    if (res.success) {

                        $('#pPrescription').text("Pr-" + res.prescriptionId);
                        $('#pPatient').text(res.patientName);
                        $('#pDoctor').text(res.doctorName);
                        $('#pTest').text(res.testName);
                        $('#pRange').text(res.normalRange);
                        $('#pActual').text(res.actualValue);
                        $('#pRemarks').text(res.remarks);
                        $('#pPrice').text("₹ " + res.bill);
                        $('#pResultDate').text(res.date);

                        var modal = new bootstrap.Modal(
                            document.getElementById('printPreviewModal')
                        );
                        modal.show();
                    }
                });
        }

        function printReportContent() {

            var printContents = document.getElementById('printArea').innerHTML;
            var originalContents = document.body.innerHTML;

            document.body.innerHTML = printContents;
            window.print();
            document.body.innerHTML = originalContents;

            location.reload();
        }


        function showSection(sectionId){
            $('.section-block').addClass('d-none');
            $('#' + sectionId).removeClass('d-none');
        }

        $(document).ready(function(){

            showSection('pendingSection');

            // Live search - Pending Table
            $("#searchPending").on("keyup", function () {

                var value = $(this).val().toLowerCase();
                var rows = $("#pendingSection table tbody tr");
                var visibleRows = 0;

                rows.each(function () {

                    if ($(this).text().toLowerCase().indexOf(value) > -1) {
                        $(this).show();
                        visibleRows++;
                    } else {
                        $(this).hide();
                    }

                });

                // Remove old message if exists
                $("#pendingNoData").remove();

                // If no rows visible, show message
                if (visibleRows === 0) {
                    $("#pendingSection table tbody").append(
                        '<tr id="pendingNoData"><td colspan="10" class="text-center text-danger fw-semibold">No matching records found</td></tr>'
                    );
                }

            });


            // Live search - Completed Table
            $("#searchCompleted").on("keyup", function () {

                var value = $(this).val().toLowerCase();
                var rows = $("#completedSection table tbody tr");
                var visibleRows = 0;

                rows.each(function () {

                    if ($(this).text().toLowerCase().indexOf(value) > -1) {
                        $(this).show();
                        visibleRows++;
                    } else {
                        $(this).hide();
                    }

                });

                // Remove old message if exists
                $("#completedNoData").remove();

                if (visibleRows === 0) {
                    $("#completedSection table tbody").append(
                        '<tr id="completedNoData"><td colspan="10" class="text-center text-danger fw-semibold">No matching records found</td></tr>'
                    );
                }

            });


            // Open modal
            $('.openResultModal').click(function(){
                $('#rPrescriptionId').val($(this).data('prescription'));
                $('#rTestId').val($(this).data('test'));
                $('#rPatientId').val($(this).data('patient'));
                $('#rNormalRange').val($(this).data('range'));
                $('#rBillAmount').val($(this).data('price'));
                $('#rEmail').val($(this).data('email'));

                var modal = new bootstrap.Modal(document.getElementById('resultModal'));
                modal.show();
            });

            // Save result
            $('#resultForm').submit(function(e){
                e.preventDefault();

                $.post('/LabTechnicians/AddLabResult',
                {
                    TestId: $('#rTestId').val(),
                    PatientId: $('#rPatientId').val(),
                    NormalRange: $('#rNormalRange').val(),
                    ActualValue: $('#rActualValue').val(),
                    Remarks: $('#rRemarks').val(),
                    PrescriptionId: $('#rPrescriptionId').val()
                },
                function(res){

                    if(res.success){

                        Swal.fire("Success",
                                  "Result Saved Successfully!",
                                  "success")
                        .then(()=>{
                            window.open('/LabTechnicians/PrintLabBill?resultId='
                                         + res.resultId,
                                         '_blank');
                            location.reload();
                        });
                    }
                    else{
            Swal.fire("Error",
                      "Something went wrong!",
                      "error");
        }
                });
            });

                    // View Lab Report Modal
            $('.viewReportBtn').click(function () {

                var resultId = $(this).data('result');

                $.get('/LabTechnicians/GetLabReportDetails',
                    { resultId: resultId },
                    function (res) {

                        if (res.success) {

                            $('#vPatient').text(res.patientName);
                            $('#vDoctor').text(res.doctorName);
                            $('#vTest').text(res.testName);
                            $('#vRange').text(res.normalRange);
                            $('#vActual').text(res.actualValue);
                            $('#vRemarks').text(res.remarks);
                            $('#vDate').text(res.date);
                            $('#vBill').text("₹ " + res.bill);

                            var modal = new bootstrap.Modal(
                                document.getElementById('viewReportModal')
                            );
                            modal.show();
                        }
                    });
            });


            // Generate Bill (DB Insert)
            $('.generateBillBtn').click(function () {

                var resultId = $(this).data('result');
                var amount = $(this).data('amount');

                $.post('/LabTechnicians/GenerateLabBill',
                    { resultId: resultId, amount: amount },
                    function (res) {

                        if (res.success) {
                            Swal.fire("Success",
                                  "Lab Bill Generated!",
                                  "success");
                        }
                    });
            });

      


        });

    </script>
}
