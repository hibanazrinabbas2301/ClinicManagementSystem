@model IEnumerable<ClinicManagementSystem.Models.LabTest>

@{
    ViewData["Title"] = "Lab Dashboard";
    var pendingTests = ViewBag.PendingTests as IEnumerable<ClinicManagementSystem.Models.LabTestPrescription>;
    int totalTests = Model.Count();
    int pending = pendingTests?.Count(t => t.Status != "Completed") ?? 0;
    int completedToday = pendingTests?.Count(t => t.Status == "Completed"
                           && t.PrescribedDate.Date == DateTime.Today) ?? 0;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary">
            <i class="fas fa-flask"></i> Lab Technician Dashboard
        </h2>

        <a href="@Url.Action("Index", "LabTechnicians")#availableTests"
           class="btn btn-dark">
            <i class="fas fa-cogs"></i> Manage Tests
        </a>
    </div>

    <div class="row g-4">

        <div class="col-md-4">
            <div class="card dashboard-card bg-primary text-white">
                <div class="card-body">
                    <h5>Total Lab Tests</h5>
                    <h1 class="counter" data-count="@totalTests">0</h1>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card dashboard-card bg-warning text-dark">
                <div class="card-body">
                    <h5>Pending Tests</h5>
                    <h1 class="counter" data-count="@pending">0</h1>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card dashboard-card bg-success text-white">
                <div class="card-body">
                    <h5>Completed Today</h5>
                    <h1 class="counter" data-count="@completedToday">0</h1>
                </div>
            </div>
        </div>

    </div>

</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $('.counter').each(function () {
        let $this = $(this),
            countTo = $this.attr('data-count');

        $({ countNum: $this.text() }).animate({
            countNum: countTo
        },
            {
                duration: 1200,
                easing: 'swing',
                step: function () {
                    $this.text(Math.floor(this.countNum));
                },
                complete: function () {
                    $this.text(this.countNum);
                }
            });
    });
</script>

<style>
    .dashboard-card {
        border: none;
        border-radius: 15px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.15);
        transition: 0.3s;
    }

        .dashboard-card:hover {
            transform: translateY(-6px);
        }

    h1 {
        font-weight: 700;
    }
</style>
