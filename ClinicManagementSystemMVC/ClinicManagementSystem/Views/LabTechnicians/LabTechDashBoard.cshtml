@model IEnumerable<ClinicManagementSystem.Models.LabTest>

@{
    ViewData["Title"] = "Lab Technician Dashboard";
    var pendingTests = ViewBag.PendingTests as IEnumerable<ClinicManagementSystem.Models.LabTestPrescription>;
}

<!-- Include Font Awesome for icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

<div class="container-fluid mt-4">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary">
            <i class="fas fa-flask"></i> Lab Technician Dashboard
        </h2>
        <a href="@Url.Action("Index", "LabTechnicians")" class="btn btn-primary">
            <i class="fas fa-cogs"></i> Manage Tests
        </a>
    </div>

    <!-- Summary Cards -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card text-white" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h5 class="card-title"><i class="fas fa-vial"></i> Total Lab Tests</h5>
                            <h2 class="card-text mb-3">@Model.Count()</h2>
                            <a href="@Url.Action("Index", "LabTechnicians")#availableTests" class="btn btn-light btn-sm">
                                <i class="fas fa-eye"></i> View Tests
                            </a>
                        </div>
                        <i class="fas fa-flask fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h5 class="card-title"><i class="fas fa-clock"></i> Pending Tests</h5>
                            <h2 class="card-text mb-3">@(pendingTests?.Count(t => t.Status != "Completed") ?? 0)</h2>
                            <a href="@Url.Action("Index", "LabTechnicians")#pendingTests" class="btn btn-light btn-sm">
                                <i class="fas fa-eye"></i> View Pending
                            </a>
                        </div>
                        <i class="fas fa-hourglass-half fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h5 class="card-title"><i class="fas fa-check-circle"></i> Completed Today</h5>
                            <h2 class="card-text mb-3">
                                @(pendingTests?.Count(t => t.Status == "Completed" && t.PrescribedDate.Date == DateTime.Today) ?? 0)
                            </h2>
                            <a href="@Url.Action("Index", "LabTechnicians")#completedTests" class="btn btn-light btn-sm">
                                <i class="fas fa-eye"></i> View Completed
                            </a>
                        </div>
                        <i class="fas fa-calendar-check fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Optional: Add any dashboard-specific scripts here
            console.log('Dashboard loaded');
        });
    </script>
}

<style>
    .card {
        border: none;
        border-radius: 10px;
        box-shadow: 0 0 20px rgba(0,0,0,0.1);
        margin-bottom: 20px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        overflow: hidden;
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        }

        .card.text-white .opacity-50 {
            opacity: 0.3;
        }

    .border.rounded {
        transition: all 0.3s ease;
    }

        .border.rounded:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

    h3 {
        font-weight: 700;
        margin-bottom: 5px;
    }
</style>